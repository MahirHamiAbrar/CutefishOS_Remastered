deleted file mode 100644
index ec63514..0000000
--- a/debian/compat
+++ /dev/null
@@ -1 +0,0 @@
-9
diff --git a/debian/control b/debian/control
index 30028e8..1c42422 100644
--- a/debian/control
+++ b/debian/control
@@ -1,14 +1,26 @@
-Source: texteditor
