From 281fdfa730fdbacef7b66c76205580c1043cf5b8 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Fri, 25 Sep 2026 22:14:33 +0600
Subject: [PATCH] Cutefish Remastered: texteditor changes

- Port to Qt 6 / KF6; open files from the command line; File menu, open/save dialogs, install rules
---
 CMakeLists.txt          | 15 +++++++----
 cutefish-editor.desktop |  2 +-
 debian/changelog        |  7 +++---
 debian/compat           |  1 -
 debian/control          | 30 +++++++++++++++-------
 debian/rules            | 23 +----------------
 qml/TextEditor.qml      | 10 +++++---
 qml/main.qml            | 55 ++++++++++++++++++++++++++++++++++++-----
 src/documenthandler.cpp |  8 +++---
 src/documenthandler.h   |  2 +-
 src/main.cpp            | 16 +++++++++---
 11 files changed, 110 insertions(+), 59 deletions(-)
 delete mode 100644 debian/compat

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 45df845..a12012a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,8 +11,9 @@ set(CMAKE_AUTORCC ON)
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
-find_package(Qt5 COMPONENTS Core Quick REQUIRED)
-find_package(KF5SyntaxHighlighting)
+find_package(Qt6 COMPONENTS Core Gui Quick REQUIRED)
+include(GNUInstallDirs)
+find_package(KF6SyntaxHighlighting REQUIRED)
 
 set(PROJECT_SOURCES
         src/main.cpp
@@ -28,7 +29,11 @@ add_executable(cutefish-texteditor
 
 target_link_libraries(cutefish-texteditor
   PRIVATE
-  Qt5::Core
-  Qt5::Quick
-  KF5::SyntaxHighlighting
+  Qt6::Core
+  Qt6::Quick
+  KF6::SyntaxHighlighting
   )
+
+set_target_properties(cutefish-texteditor PROPERTIES OUTPUT_NAME cutefish-editor)
+install(TARGETS cutefish-texteditor RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+install(FILES cutefish-editor.desktop DESTINATION ${CMAKE_INSTALL_DATADIR}/applications)
diff --git a/cutefish-editor.desktop b/cutefish-editor.desktop
index 5e74075..d0ebd55 100644
--- a/cutefish-editor.desktop
+++ b/cutefish-editor.desktop
@@ -2,7 +2,7 @@
 Categories=Utility;TextEditor;
 Comment=General text editor
 Exec=cutefish-editor %F
-Icon=cutefish-editor
+Icon=accessories-text-editor
 Name=Cutefish Text Editor
 GenericName=Cutefish Text Editor
 StartupNotify=false
diff --git a/debian/changelog b/debian/changelog
index 311c8af..d04f7db 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,5 +1,6 @@
-texteditor (0.7-1) UNRELEASED; urgency=medium
