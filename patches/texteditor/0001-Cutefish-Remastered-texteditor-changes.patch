diff --git a/debian/rules b/debian/rules
index 08ae9b5..2d33f6a 100755
--- a/debian/rules
+++ b/debian/rules
@@ -1,25 +1,4 @@
 #!/usr/bin/make -f
-# See debhelper(7) (uncomment to enable)
-# output every command that modifies files on the build system.
-#export DH_VERBOSE = 1
-
-
-# see FEATURE AREAS in dpkg-buildflags(1)
-#export DEB_BUILD_MAINT_OPTIONS = hardening=+all
-
-# see ENVIRONMENT in dpkg-buildflags(1)
-# package maintainers to append CFLAGS
-#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
-# package maintainers to append LDFLAGS
-#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed
-
 
 %:
-	dh $@ --parallel
-
-
-# dh_make generated override targets
-# This is example for Cmake (See https://bugs.debian.org/641051 )
-#override_dh_auto_configure:
-#	dh_auto_configure -- \
-#	-DCMAKE_LIBRARY_PATH=$(DEB_HOST_MULTIARCH)
+	dh $@
diff --git a/qml/TextEditor.qml b/qml/TextEditor.qml
index ed803cf..66adff0 100644
--- a/qml/TextEditor.qml
+++ b/qml/TextEditor.qml
@@ -9,7 +9,7 @@ import Cutefish.TextEditor 1.0
 Item {
     id: control
 
-    property var tabName: document.fileName + (document.modified ? " *" : "")
+    property var tabName: (document.fileName !== "" ? document.fileName : qsTr("Untitled")) + (document.modified ? " *" : "")
 
     property alias fileUrl: document.fileUrl
     property alias fileName: document.fileName
@@ -33,9 +33,6 @@ Item {
             body.select(start, end)
         }
 
-        onFileSaved: {
-            root.showPassiveNotification(qsTr("Saved successfully"), 3000)
-        }
     }
 
     ScrollView {
@@ -209,4 +206,9 @@ Item {
     function save() {
         document.saveAs(document.fileUrl)
     }
+
+    function saveAs(url) {
+        document.saveAs(url)
+        document.fileUrl = url
+    }
 }
diff --git a/qml/main.qml b/qml/main.qml
index dcadcc2..e7d5f2e 100644
--- a/qml/main.qml
+++ b/qml/main.qml
@@ -4,6 +4,7 @@ import QtQuick.Controls 2.15
 import QtQuick.Layouts 1.15
 import FishUI 1.0 as FishUI
 import Cutefish.TextEditor 1.0
+import Qt.labs.platform as Platform
 
 FishUI.Window {
     id: root
@@ -17,8 +18,8 @@ FishUI.Window {
     FileHelper {
         id: fileHelper
 
-        onNewPath: {
-            _tabView.addTab(textEditorCompeont, { fileUrl: path })
+        function onNewPath(path) {
+            root.addPath(path)
         }
     }
 
@@ -72,7 +73,7 @@ FishUI.Window {
         id: _dropArea
         anchors.fill: parent
 
-        onDropped: {
+        onDropped: (drop) => {
             if (drop.hasUrls) {
                 for (var i = 0; i < drop.urls.length; ++i) {
                     fileHelper.addPath(drop.urls[i])
@@ -127,12 +128,54 @@ FishUI.Window {
     Component {
         id: textEditorCompeont
 
-        TextEditor {
-            fileUrl: "file:///home/cutefish/桌面/winepath"
+        TextEditor {}
+    }
+
+    // Exported to the Cutefish status bar as the global menu.
+    Platform.MenuBar {
+        Platform.Menu {
+            title: qsTr("File")
+            Platform.MenuItem { text: qsTr("New Tab"); shortcut: StandardKey.New; onTriggered: root.addTab() }
+            Platform.MenuItem { text: qsTr("Open..."); shortcut: StandardKey.Open; onTriggered: _openDialog.open() }
+            Platform.MenuItem { text: qsTr("Save"); shortcut: StandardKey.Save; onTriggered: root.saveCurrent() }
+            Platform.MenuItem { text: qsTr("Save As..."); shortcut: StandardKey.SaveAs; onTriggered: _saveDialog.open() }
+            Platform.MenuSeparator {}
+            Platform.MenuItem { text: qsTr("Close Tab"); shortcut: StandardKey.Close; onTriggered: _tabView.closeTab(_tabView.currentIndex) }
+            Platform.MenuItem { text: qsTr("Quit"); shortcut: StandardKey.Quit; onTriggered: Qt.quit() }
+        }
+    }
+
+    Platform.FileDialog {
+        id: _openDialog
+        fileMode: Platform.FileDialog.OpenFiles
+        onAccepted: {
+            for (var i = 0; i < files.length; ++i)
+                root.addPath(files[i])
         }
     }
 
+    Platform.FileDialog {
+        id: _saveDialog
+        fileMode: Platform.FileDialog.SaveFile
+        onAccepted: {
+            if (_tabView.currentItem)
+                _tabView.currentItem.saveAs(file)
+        }
+    }
+
+    function saveCurrent() {
+        if (!_tabView.currentItem)
+            return
+        if (_tabView.currentItem.fileUrl.toString() === "")
+            _saveDialog.open()
+        else
+            _tabView.currentItem.save()
+    }
+
     Component.onCompleted: {
-        // addTab()
+        for (var i = 0; i < startupFiles.length; ++i)
+            addPath(startupFiles[i])
+        if (_tabView.count === 0)
+            addTab()
     }
 }
diff --git a/src/documenthandler.cpp b/src/documenthandler.cpp
index 8e224d4..81918d8 100644
--- a/src/documenthandler.cpp
+++ b/src/documenthandler.cpp
@@ -60,7 +60,7 @@
 #include <QQmlFileSelector>
 #include <QQuickTextDocument>
 #include <QTextCharFormat>
-#include <QTextCodec>
+#include <QStringDecoder>
 #include <QTextDocument>
 #include <QTextDocumentWriter>
 #include <QUrl>
@@ -153,8 +153,10 @@ void FileLoader::loadFile(const QUrl &url)
 
     if (file.open(QFile::ReadOnly)) {
         const auto array = file.readAll();
-        QTextCodec *codec = QTextDocumentWriter(url.toLocalFile()).codec();
-        emit this->fileReady(codec->toUnicode(array), url);
+        // Honour a BOM if present, otherwise assume UTF-8 (QTextCodec is gone in Qt 6).
+        const auto encoding = QStringConverter::encodingForData(array).value_or(QStringConverter::Utf8);
+        QStringDecoder decoder(encoding);
+        emit this->fileReady(decoder(array), url);
     }
 }
 
diff --git a/src/documenthandler.h b/src/documenthandler.h
index c2c1105..a411b06 100644
--- a/src/documenthandler.h
+++ b/src/documenthandler.h
@@ -63,7 +63,7 @@
 QT_BEGIN_NAMESPACE
 class QFileSystemWatcher;
 class QTextDocument;
-class QQuickTextDocument;
+#include <QQuickTextDocument> // moc in Qt 6 needs the complete type
 QT_END_NAMESPACE
 
 namespace KSyntaxHighlighting
diff --git a/src/main.cpp b/src/main.cpp
index e583821..878c905 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1,16 +1,23 @@
 #include <QGuiApplication>
 #include <QQmlApplicationEngine>
+#include <QQmlContext>
+#include <QUrl>
+#include <QDir>
+#include <QIcon>
 #include "documenthandler.h"
 #include "highlightmodel.h"
 #include "texteditor.h"
 
 int main(int argc, char *argv[])
 {
-#if QT_VERSION < QT_VERSION_CHECK(6, 0, 0)
-    QCoreApplication::setAttribute(Qt::AA_EnableHighDpiScaling);
-#endif
-
     QGuiApplication app(argc, argv);
+    app.setWindowIcon(QIcon::fromTheme("accessories-text-editor"));
+    QGuiApplication::setDesktopFileName("cutefish-editor");
+
+    // Files passed on the command line (Exec=cutefish-editor %F).
+    QStringList startupFiles;
+    for (const QString &arg : app.arguments().mid(1))
+        startupFiles << QUrl::fromUserInput(arg, QDir::currentPath(), QUrl::AssumeLocalFile).toString();
 
     qmlRegisterType<DocumentHandler>("Cutefish.TextEditor", 1, 0, "DocumentHandler");
     qmlRegisterType<FileHelper>("Cutefish.TextEditor", 1, 0, "FileHelper");
@@ -18,6 +25,7 @@ int main(int argc, char *argv[])
     HighlightModel m;
 
     QQmlApplicationEngine engine;
+    engine.rootContext()->setContextProperty("startupFiles", startupFiles);
     const QUrl url(QStringLiteral("qrc:/qml/main.qml"));
     QObject::connect(&engine, &QQmlApplicationEngine::objectCreated,
                      &app, [url](QObject *obj, const QUrl &objUrl) {
