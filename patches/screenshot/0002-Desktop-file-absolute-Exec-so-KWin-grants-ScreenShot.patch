From 188d59e9a275b57b8a6bcfe258b23d632faa78a5 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sat, 26 Sep 2026 10:39:31 +0600
Subject: [PATCH 2/2] Desktop file: absolute Exec, so KWin grants ScreenShot2

---
 cutefish-screenshot.desktop | 6 ++++--
 debian/changelog            | 6 ++++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/cutefish-screenshot.desktop b/cutefish-screenshot.desktop
index 26fb1ff..07ca03d 100644
--- a/cutefish-screenshot.desktop
+++ b/cutefish-screenshot.desktop
@@ -1,11 +1,13 @@
 [Desktop Entry]
 Name=Screenshot
 Name[zh_CN]=截图
-Exec=cutefish-screenshot
+Exec=/usr/bin/cutefish-screenshot
 Icon=cutefish-screenshot
 Terminal=false
 Type=Application
 StartupNotify=true
 Categories=Utility;Graphics;
-# KWin only serves org.kde.KWin.ScreenShot2 to apps that declare it here.
+# KWin only serves org.kde.KWin.ScreenShot2 to apps that declare it here. It
+# finds this file by comparing Exec's program, as an absolute path, with the
+# caller's executable, so Exec must not rely on PATH.
 X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
diff --git a/debian/changelog b/debian/changelog
index 71f398e..b1debdc 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-screenshot (0.8+remastered2) resolute; urgency=medium
+
+  * Desktop file: absolute Exec, so KWin grants ScreenShot2
+
+ -- Cutefish Remastered <remastered@localhost>  Sat, 26 Sep 2026 10:39:31 +0600
+
 cutefish-screenshot (0.8+remastered1) resolute; urgency=medium
 
   * Port to Qt 6 and capture through KWin ScreenShot2 on Wayland.
-- 
