 #include <QPixmap>
 #include <QStandardPaths>
 #include <QDateTime>
+#include <QDebug>
 
 #include <QDBusInterface>
 #include <QDBusPendingCall>
+#include <QDBusReply>
+#include <QDBusUnixFileDescriptor>
+#include <QFile>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+// Grab one output in device pixels (QML crops with devicePixelRatio) through KWin's ScreenShot2 D-Bus API. On Wayland no client
+// may read the screen itself; KWin writes the raw pixels into a pipe we pass it
+// and returns the image layout in the reply.
+static QImage captureScreen(QScreen *screen)
+{
+    int fds[2];
+    if (pipe2(fds, O_CLOEXEC) != 0)
+        return {};
+
+    QDBusInterface kwin("org.kde.KWin", "/org/kde/KWin/ScreenShot2",
+                        "org.kde.KWin.ScreenShot2", QDBusConnection::sessionBus());
+    const QVariantMap options{{"native-resolution", true}, {"include-cursor", false}};
+    QDBusReply<QVariantMap> reply = kwin.call("CaptureScreen", screen->name(), options,
+                                              QVariant::fromValue(QDBusUnixFileDescriptor(fds[1])));
+    close(fds[1]);
+
+    QByteArray data;
+    if (reply.isValid()) {
+        QFile pipeFile;
+        if (pipeFile.open(fds[0], QIODevice::ReadOnly, QFileDevice::DontCloseHandle))
+            data = pipeFile.readAll();
+    } else {
+        qWarning() << "ScreenShot2 failed:" << reply.error().message();
+    }
+    close(fds[0]);
+
+    const QVariantMap info = reply.value();
+    const int width = info.value("width").toInt();
+    const int height = info.value("height").toInt();
+    const int stride = info.value("stride").toInt();
+    const auto format = QImage::Format(info.value("format").toInt());
+    if (width <= 0 || height <= 0 || data.size() < qint64(stride) * height)
+        return {};
+
+    QImage image(reinterpret_cast<const uchar *>(data.constData()), width, height, stride, format);
+    return image.copy();
+}
 
