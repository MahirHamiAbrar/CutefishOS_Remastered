+    qDeleteAll(m_secondaryStatusBars);
     delete m_statusBar;
 }
 
+void Shell::syncSecondaryStatusBars()
+{
+    QScreen *primary = QGuiApplication::primaryScreen();
+    const QList<QScreen *> screens = QGuiApplication::screens();
+
+    for (auto it = m_secondaryStatusBars.begin(); it != m_secondaryStatusBars.end();) {
+        if (it.key() == primary || !screens.contains(it.key())) {
+            it.value()->setVisible(false);
+            it.value()->deleteLater();
+            it = m_secondaryStatusBars.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    for (QScreen *screen : screens) {
+        if (screen != primary && !m_secondaryStatusBars.contains(screen))
+            m_secondaryStatusBars.insert(screen, new StatusBar(m_engine, screen));
+    }
+}
+
 void Shell::registerQmlTypes()
 {
     registerApplicationsQmlTypes();
@@ -147,6 +171,12 @@ void Shell::start()
     m_statusBar = new StatusBar(m_engine);
     bus.registerObject(QStringLiteral("/Statusbar"), m_statusBar);
 
+    syncSecondaryStatusBars();
+    // Queued: the screen list and the primary screen settle after the signal.
+    connect(qGuiApp, &QGuiApplication::screenAdded, this, &Shell::syncSecondaryStatusBars, Qt::QueuedConnection);
+    connect(qGuiApp, &QGuiApplication::screenRemoved, this, &Shell::syncSecondaryStatusBars, Qt::QueuedConnection);
+    connect(qGuiApp, &QGuiApplication::primaryScreenChanged, this, &Shell::syncSecondaryStatusBars, Qt::QueuedConnection);
+
     m_launcher = new Launcher(m_engine);
     bus.registerObject(QStringLiteral("/Launcher"),
                        QStringLiteral("com.cutefish.Launcher"), m_launcher);
