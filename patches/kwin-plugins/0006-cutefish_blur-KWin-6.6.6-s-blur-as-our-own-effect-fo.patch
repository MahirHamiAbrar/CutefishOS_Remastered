+                                                                                     QStringLiteral(":/effects/cutefish_blur/shaders/onscreen_rounded.vert"),
+                                                                                     QStringLiteral(":/effects/cutefish_blur/shaders/onscreen_rounded.frag"));
+    if (!m_roundedOnscreenPass.shader) {
+        qCWarning(CUTEFISH_BLUR) << "Failed to load onscreen pass shader";
+        return;
+    } else {
+        m_roundedOnscreenPass.mvpMatrixLocation = m_roundedOnscreenPass.shader->uniformLocation("modelViewProjectionMatrix");
