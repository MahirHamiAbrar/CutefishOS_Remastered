From a8da616baa233f805f0b977f90a48cb0ee12023b Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sun, 27 Sep 2026 03:15:36 +0600
Subject: [PATCH 5/7] Require KDecoration3: a missing one silently dropped the
 decoration

---
 debian/changelog       |  6 ++++++
 plugins/CMakeLists.txt | 11 ++++-------
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/debian/changelog b/debian/changelog
index 2743fbc..84ccb78 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-kwin-plugins (0.8+remastered5) resolute; urgency=medium
+
+  * Require KDecoration3: a missing one silently dropped the decoration
+
+ -- Cutefish Remastered <remastered@localhost>  Sun, 27 Sep 2026 03:15:36 +0600
+
 cutefish-kwin-plugins (0.8+remastered4) resolute; urgency=medium
 
   * roundedwindow: KWin 6.6 folded OpenGlContext into EglContext
diff --git a/plugins/CMakeLists.txt b/plugins/CMakeLists.txt
index bd6f3f4..b6f6aa7 100644
--- a/plugins/CMakeLists.txt
+++ b/plugins/CMakeLists.txt
@@ -2,13 +2,10 @@ option(CUTEFISH_BUILD_KWIN6_DECORATION "Build the KDecoration3 plugin used by KW
 option(CUTEFISH_BUILD_KWIN6_EFFECT "Build the rounded corners effect for KWin6" ON)
 
 if(CUTEFISH_BUILD_KWIN6_DECORATION)
-    find_package(KDecoration3 QUIET)
-    if(KDecoration3_FOUND)
-        add_subdirectory(decoration)
-        message(STATUS "KDecoration3 found: building Cutefish KWin6 decoration")
-    else()
-        message(WARNING "KDecoration3 was not found; the KWin6 decoration will not be built. Install libkdecorations3-dev or disable CUTEFISH_BUILD_KWIN6_DECORATION.")
-    endif()
+    # REQUIRED for the same reason as the effect below: without the
+    # decoration, windows lose their title bars and rounded top corners.
+    find_package(KDecoration3 REQUIRED)
+    add_subdirectory(decoration)
 endif()
 
 if(CUTEFISH_BUILD_KWIN6_EFFECT)
-- 
