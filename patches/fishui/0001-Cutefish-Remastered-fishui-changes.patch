From f631c0679c08c018d36abb1b4a812c02f1294d9e Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Fri, 25 Sep 2026 22:14:32 +0600
Subject: [PATCH 1/4] Cutefish Remastered: fishui changes

- Blur and translucency behind every FishUI window by default (macOS vibrancy)
---
 debian/changelog        |  6 ++++++
 debian/control          |  1 +
 src/controls/Window.qml | 12 ++++++++++++
 3 files changed, 19 insertions(+)

diff --git a/debian/changelog b/debian/changelog
index 0133272..d323fa0 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+fishui (0.8+remastered1) resolute; urgency=medium
+
+  * Blur and translucency behind every FishUI window by default (macOS vibrancy)
+
+ -- Cutefish Remastered <remastered@localhost>  Fri, 25 Sep 2026 21:38:17 +0600
+
 fishui (0.8) UNRELEASED; urgency=high
 
   * Initial release (CutefishOS)  <support@cutefishos.com>
diff --git a/debian/control b/debian/control
index 4e4c670..0374b9d 100644
--- a/debian/control
+++ b/debian/control
@@ -24,6 +24,7 @@ Depends: qml6-module-qtquick-controls,
          qml6-module-qtquick-shapes,
          qml6-module-qt5compat-graphicaleffects,
          libcutefish,
+         qt6-svg-plugins,
          ${misc:Depends},
          ${shlibs:Depends}
 Description: CutefishOS UIKit
diff --git a/src/controls/Window.qml b/src/controls/Window.qml
index a3e9dfc..0abbe94 100644
--- a/src/controls/Window.qml
+++ b/src/controls/Window.qml
@@ -55,6 +55,11 @@ Window {
 
     property bool minimizeButtonVisible: true
 
+    // macOS-like vibrancy: every FishUI window is translucent with the desktop
+    // blurred behind it while blur is enabled in Settings. Apps can opt out by
+    // setting blurBehind: false or override background.opacity.
+    property bool blurBehind: FishUI.Theme.blurEnabled
+
     property var windowButtonsAlignment: Qt.AlignTop
     property real windowButtonsTopMargin: FishUI.Units.smallSpacing
     property real windowButtonsRightMargin: windowButtonsTopMargin
@@ -87,6 +92,12 @@ Window {
         }
     }
 
+    FishUI.WindowBlur {
+        view: control
+        windowRadius: _background.radius
+        enabled: control.blurBehind
+    }
+
     // Window shadows
     FishUI.WindowShadow {
         view: control
@@ -200,6 +211,7 @@ Window {
         anchors.fill: parent
         radius: !isMaximized && !isFullScreen ? control.windowRadius : 0
         color: FishUI.Theme.backgroundColor
+        opacity: control.blurBehind ? (FishUI.Theme.darkMode ? 0.78 : 0.82) : 1
         antialiasing: true
 
         border.width: control._borderWidth
-- 
2.43.0

