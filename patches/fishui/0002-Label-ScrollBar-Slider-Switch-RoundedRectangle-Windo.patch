diff --git a/src/controls/ScrollBar.qml b/src/controls/ScrollBar.qml
new file mode 100644
index 0000000..1ebf48f
--- /dev/null
+++ b/src/controls/ScrollBar.qml
@@ -0,0 +1,29 @@
+import QtQuick
+import QtQuick.Controls as QQC2
+import FishUI 1.0 as FishUI
+
+// An overlay scroll bar: a thin handle that widens under the pointer and fades
+// out when idle. darkMode picks a light handle for dark surfaces that don't
+// follow the system theme (a terminal colour scheme, a video).
+QQC2.ScrollBar {
+    id: control
+
+    property bool darkMode: FishUI.Theme.darkMode
+
+    padding: 2
+    minimumSize: 0.05
+
+    contentItem: Rectangle {
+        implicitWidth: control.hovered || control.pressed ? 8 : 5
+        implicitHeight: implicitWidth
+        radius: Math.min(width, height) / 2
+        color: control.darkMode ? Qt.rgba(1, 1, 1, control.pressed ? 0.55 : 0.4)
+                                : Qt.rgba(0, 0, 0, control.pressed ? 0.55 : 0.4)
+        opacity: control.active && control.size < 1 ? 1 : 0
+
+        Behavior on implicitWidth { NumberAnimation { duration: 120 } }
+        Behavior on opacity { NumberAnimation { duration: 250 } }
+    }
+
+    background: Item {}
+}
