From e3d6297042a36b7e752120c3037ff990d493e2c5 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sun, 27 Sep 2026 20:50:05 +0600
Subject: [PATCH 6/6] SegmentedControl: rounded rectangles instead of pills;
 the selected tab slides

---
 debian/changelog                  |  6 ++++++
 src/controls/SegmentedControl.qml | 12 ++++++++----
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/debian/changelog b/debian/changelog
index 1adff92..5e22981 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+fishui (0.8+remastered6) resolute; urgency=medium
+
+  * SegmentedControl: rounded rectangles instead of pills; the selected tab slides
+
+ -- Cutefish Remastered <remastered@localhost>  Sun, 27 Sep 2026 20:50:05 +0600
+
 fishui (0.8+remastered5) resolute; urgency=medium
 
   * Window: parentWindow (transient parent) for every window, not only ConfirmDialog; Terminal's settings dialog is a plain Window
diff --git a/src/controls/SegmentedControl.qml b/src/controls/SegmentedControl.qml
index 529db16..6fc9b26 100644
--- a/src/controls/SegmentedControl.qml
+++ b/src/controls/SegmentedControl.qml
@@ -24,8 +24,11 @@ T.TabBar {
         flickableDirection: Flickable.AutoFlickIfNeeded
         snapMode: ListView.SnapToItem
 
-        highlightMoveDuration: 0
-        highlightResizeDuration: 0
+        // The selected tab slides over instead of jumping.
+        highlightMoveDuration: 150
+        highlightMoveVelocity: -1
+        highlightResizeDuration: 150
+        highlightResizeVelocity: -1
         highlightFollowsCurrentItem: true
         highlightRangeMode: ListView.ApplyRange
         preferredHighlightBegin: 48
@@ -39,7 +42,8 @@ T.TabBar {
                 }
                 color: FishUI.Theme.darkMode ? Qt.lighter(FishUI.Theme.secondBackgroundColor, 2)
                                              : FishUI.Theme.secondBackgroundColor
-                radius: height / 2
+                // Rounded rectangles, like the Fish TabBar (not pills).
+                radius: FishUI.Theme.smallRadius
 
                 layer.enabled: true
                 layer.effect: DropShadow {
@@ -56,6 +60,6 @@ T.TabBar {
 
     background: Rectangle {
         color: FishUI.Theme.alternateBackgroundColor
-        radius: height / 2
+        radius: FishUI.Theme.smallRadius + control.padding
     }
 }
-- 
2.43.0

