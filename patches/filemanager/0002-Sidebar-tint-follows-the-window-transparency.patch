From: remastered <remastered@localhost>
Date: Sun, 27 Sep 2026 02:08:35 +0600
Subject: [PATCH 2/2] Sidebar tint follows the window transparency

---
 debian/changelog | 6 ++++++
 qml/SideBar.qml  | 4 +++-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/debian/changelog b/debian/changelog
index 2f61125..2c0a7fc 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-filemanager (0.8+remastered2) resolute; urgency=medium
+
+  * Sidebar tint follows the window transparency
+
+ -- Cutefish Remastered <remastered@localhost>  Sun, 27 Sep 2026 02:08:35 +0600
+
 cutefish-filemanager (0.8+remastered1) resolute; urgency=medium
 
   * Follow the default FishUI window translucency
diff --git a/qml/SideBar.qml b/qml/SideBar.qml
index e6aeda2..5ed73bb 100644
--- a/qml/SideBar.qml
+++ b/qml/SideBar.qml
@@ -60,7 +60,9 @@ Item {
         anchors.fill: parent
         color: FishUI.Theme.darkMode ? Qt.lighter(FishUI.Theme.backgroundColor, 1.5)
                                      : Qt.darker(FishUI.Theme.backgroundColor, 1.05)
-        opacity: 0.7
+        // A light tint over the already translucent window, so the sidebar
+        // stays frosted and follows the transparency setting.
+        opacity: FishUI.Theme.blurEnabled ? 0.3 : 0.7
 
         Behavior on color {
             ColorAnimation {
