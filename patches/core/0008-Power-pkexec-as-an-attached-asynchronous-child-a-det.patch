From 4acef35d52fa58b9bf63175ec0f2c67f2ef3cc6a Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sun, 27 Sep 2026 23:39:18 +0600
Subject: [PATCH 8/8] Power: pkexec as an attached, asynchronous child (a
 detached pkexec's parent is init: Not authorized); depend on pkexec
 (brightness and power mode used it, but nothing installed it)

---
 cutefish-services/power/cpumanagement.cpp | 14 +++++++++-----
 debian/changelog                          |  6 ++++++
 debian/control                            |  1 +
 3 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/cutefish-services/power/cpumanagement.cpp b/cutefish-services/power/cpumanagement.cpp
index 262394e..6cd302f 100644
--- a/cutefish-services/power/cpumanagement.cpp
+++ b/cutefish-services/power/cpumanagement.cpp
@@ -59,12 +59,16 @@ void CPUManagement::setMode(int value)
     if (modeString.isEmpty() || mode == m_currentMode)
         return;
 
-    // Detached: this also runs at login (the saved mode is re-applied), and
-    // one pkexec per CPU would stall the services daemon.
+    // Asynchronous, so the daemon doesn't stall (this also runs at login to
+    // re-apply the saved mode), but not detached: pkexec authorizes its
+    // parent process, and a detached pkexec's parent is init ("Not authorized").
     for (int i = 0; i < m_items.count(); ++i) {
-        QProcess::startDetached("pkexec", QStringList() << "cutefish-cpufreq"
-                                                        << "-s" << "-c" << QString::number(i)
-                                                        << "-m" << modeString);
+        auto *process = new QProcess(this);
+        connect(process, &QProcess::finished, process, &QObject::deleteLater);
+        connect(process, &QProcess::errorOccurred, process, &QObject::deleteLater);
+        process->start("pkexec", QStringList() << "cutefish-cpufreq"
+                                               << "-s" << "-c" << QString::number(i)
+                                               << "-m" << modeString);
     }
 
     m_currentMode = mode;
diff --git a/debian/changelog b/debian/changelog
index 8cb54ee..49f5b24 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-core (0.8+remastered8) resolute; urgency=medium
+
+  * Power: pkexec as an attached, asynchronous child (a detached pkexec's parent is init: Not authorized); depend on pkexec (brightness and power mode used it, but nothing installed it)
+
+ -- Cutefish Remastered <remastered@localhost>  Sun, 27 Sep 2026 23:39:18 +0600
+
 cutefish-core (0.8+remastered7) resolute; urgency=medium
 
   * Power: save the chosen mode and apply it again at login; no pkexec per CPU blocking the daemon; no off-by-one CPU
diff --git a/debian/control b/debian/control
index daa23dd..036f250 100644
--- a/debian/control
+++ b/debian/control
@@ -23,6 +23,7 @@ Homepage: https://github.com/cutefishos/core
 Package: cutefish-core
 Architecture: any
 Depends: accountsservice,
+         pkexec,
          qml6-module-qtquick-controls,
          qml6-module-qtquick,
          qml6-module-qtquick-layouts,
