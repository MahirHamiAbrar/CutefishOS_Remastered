From 93a19a247346bf99b083fd7204309aedd92048ca Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sat, 26 Sep 2026 10:11:41 +0600
Subject: [PATCH 3/3] Session: use the Cutefish lock screen
 (PLASMA_DEFAULT_SHELL)

---
 debian/changelog                 | 6 ++++++
 session/cutefish-wayland-session | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/debian/changelog b/debian/changelog
index 7ec0423..49447ef 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-core (0.8+remastered3) resolute; urgency=medium
+
+  * Session: use the Cutefish lock screen (PLASMA_DEFAULT_SHELL)
+
+ -- Cutefish Remastered <remastered@localhost>  Sat, 26 Sep 2026 10:11:41 +0600
+
 cutefish-core (0.8+remastered2) resolute; urgency=medium
 
   * Autostart: follow the XDG rules (OnlyShowIn/NotShowIn, Hidden, TryExec, user overrides) instead of skipping every OnlyShowIn entry
diff --git a/session/cutefish-wayland-session b/session/cutefish-wayland-session
index a6d4768..24dc969 100755
--- a/session/cutefish-wayland-session
+++ b/session/cutefish-wayland-session
@@ -19,6 +19,12 @@ export DESKTOP_SESSION=Cutefish
 # through the cutefish platform theme, picked from XDG_CURRENT_DESKTOP.
 export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}appmenu-gtk-module"
 
+# kscreenlocker's greeter (started by KWin) loads its lock screen from this
+# Plasma/Shell package, shipped by cutefish-desktop. Without it the greeter
+# falls back to a theme that needs Plasma workspace modules and crashes, and
+# a locked session could not be unlocked.
+export PLASMA_DEFAULT_SHELL=org.cutefish.desktop
+
 # Keep Xwayland available for legacy X11 session agents such as
 # spice-vdagent. The agent uses X11 selections and cannot connect to the
 # native Wayland display directly; KWin bridges the Xwayland clipboard into
-- 
2.43.0

