+// XDG autostart rules: a user entry replaces the system entry of the same
+// name; Hidden disables it; OnlyShowIn/NotShowIn are matched against this
+// desktop; a missing TryExec skips it. NoDisplay does not apply to autostart.
+static bool shouldAutostart(const DesktopEntryData &entry)
+{
+    if (entry.hidden || entry.exec.isEmpty())
+        return false;
+    if (!entry.tryExec.isEmpty() && QStandardPaths::findExecutable(entry.tryExec).isEmpty()
+            && !QFileInfo(entry.tryExec).isExecutable())
+        return false;
+
+    const QStringList desktops = DesktopEntry::currentDesktops();
+    auto matches = [&desktops](const QStringList &list) {
+        for (const QString &desktop : list) {
+            if (desktops.contains(desktop, Qt::CaseInsensitive))
+                return true;
+        }
+        return false;
+    };
+    if (!entry.onlyShowIn.isEmpty() && !matches(entry.onlyShowIn))
+        return false;
+    return !matches(entry.notShowIn);
+}
+
 void ProcessManager::loadAutoStartProcess()
 {
     QStringList execList;
+    QSet<QString> seen;
+    // User directories come first, so their entries win.
     const QStringList dirs = QStandardPaths::locateAll(QStandardPaths::GenericConfigLocation,
                                                        QStringLiteral("autostart"),
                                                        QStandardPaths::LocateDirectory);
@@ -244,21 +274,23 @@ void ProcessManager::loadAutoStartProcess()
         const QDir d(dir);
