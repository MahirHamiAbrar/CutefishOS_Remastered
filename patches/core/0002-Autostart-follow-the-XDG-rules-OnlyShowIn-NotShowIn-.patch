+            if (!f.open(QIODevice::ReadOnly)
+                    || !DesktopEntry::parse(file, f.fileName(), f.readAll(), &entry)
+                    || !shouldAutostart(entry))
+                continue;
 
-            if (execValue.contains("cutefish-services") ||
-                    execValue.contains("cutefish-appruntime"))
