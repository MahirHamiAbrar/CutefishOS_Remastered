From 4d3a6016dea07df3b00043416820fd175dbd7b95 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sun, 27 Sep 2026 02:08:35 +0600
Subject: [PATCH 5/5] Appearance service: windowOpacity and windowRadius; Inter
 / JetBrains Mono as the default fonts

---
 .../appearance/com.cutefish.Appearance.xml    | 12 +++++
 cutefish-services/appearance/thememanager.cpp | 49 ++++++++++++++++---
 cutefish-services/appearance/thememanager.h   | 15 ++++++
 debian/changelog                              |  6 +++
 4 files changed, 76 insertions(+), 6 deletions(-)

diff --git a/cutefish-services/appearance/com.cutefish.Appearance.xml b/cutefish-services/appearance/com.cutefish.Appearance.xml
index c5af9d2..e84f56a 100644
--- a/cutefish-services/appearance/com.cutefish.Appearance.xml
+++ b/cutefish-services/appearance/com.cutefish.Appearance.xml
@@ -10,6 +10,12 @@
     <method name="setBlurEnabled">
         <arg name="blurEnabled" type="b" direction="in"/>
     </method>
+    <method name="setWindowOpacity">
+        <arg name="windowOpacity" type="d" direction="in"/>
+    </method>
+    <method name="setWindowRadius">
+        <arg name="windowRadius" type="i" direction="in"/>
+    </method>
     <method name="setBackgroundVisible">
         <arg name="BackgroundVisible" type="b" direction="in"/>
     </method>
@@ -50,6 +56,8 @@
     <property name="isDarkMode" type="b" access="read"/>
     <property name="darkModeDimsWallpaer" type="b" access="read"/>
     <property name="blurEnabled" type="b" access="read"/>
+    <property name="windowOpacity" type="d" access="read"/>
+    <property name="windowRadius" type="i" access="read"/>
     <property name="backgroundVisible" type="b" access="read"/>
     <property name="systemFont" type="s" access="read"/>
     <property name="systemFixedFont" type="s" access="read"/>
@@ -72,6 +80,10 @@
     </signal>
     <signal name="blurEnabledChanged">
     </signal>
+    <signal name="windowOpacityChanged">
+    </signal>
+    <signal name="windowRadiusChanged">
+    </signal>
     <signal name="backgroundVisibleChanged">
     </signal>
     <signal name="accentColorChanged">
diff --git a/cutefish-services/appearance/thememanager.cpp b/cutefish-services/appearance/thememanager.cpp
index 813c39a..560bc4a 100644
--- a/cutefish-services/appearance/thememanager.cpp
+++ b/cutefish-services/appearance/thememanager.cpp
@@ -68,6 +68,8 @@ ThemeManager::ThemeManager(QObject *parent)
     m_isDarkMode = m_settings->value("DarkMode", false).toBool();
     m_darkModeDimsWallpaer = m_settings->value("DarkModeDimsWallpaer", false).toBool();
     m_blurEnabled = m_settings->value("BlurEnabled", true).toBool();
+    m_windowOpacity = qBound(0.4, m_settings->value("WindowOpacity", 0.7).toDouble(), 1.0);
+    m_windowRadius = qBound(0, m_settings->value("WindowRadius", 14).toInt(), 24);
     m_backgroundVisible = true;
     m_wallpaperPath = m_settings->value("Wallpaper", "/usr/share/backgrounds/cutefishos/default.jpg").toString();
     m_accentColor = m_settings->value("AccentColor", 0).toInt();
@@ -82,7 +84,7 @@ ThemeManager::ThemeManager(QObject *parent)
 
     // Init fonts.
     if (!m_settings->contains(s_systemFixedFontName)) {
-        m_settings->setValue(s_systemFixedFontName, "Monospace");
+        m_settings->setValue(s_systemFixedFontName, "JetBrains Mono");
     }
 
     if (!m_settings->contains(s_systemFontName)) {
@@ -92,8 +94,6 @@ ThemeManager::ThemeManager(QObject *parent)
 
         if (languageCode == "zh_CN") {
             fontName = "Noto Sans CJK SC";
-        } else if (languageCode.contains("en_")) {
-            fontName = "Noto Sans";
         } else if (languageCode == "zh_TW") {
             fontName = "Noto Sans CJK TC";
         } else if (languageCode == "zh_HK") {
@@ -101,7 +101,9 @@ ThemeManager::ThemeManager(QObject *parent)
         } else if (languageCode == "ja_JP") {
             fontName = "Noto Serif CJK JP";
         } else {
-            fontName = "Noto Sans";
+            // Inter has no CJK glyphs; other scripts (Bengali, Devanagari...)
+            // fall back to Noto through fontconfig.
+            fontName = "Inter";
         }
 
         m_settings->setValue(s_systemFontName, fontName);
@@ -162,6 +164,41 @@ void ThemeManager::setBlurEnabled(bool value)
     emit blurEnabledChanged();
 }
 
+double ThemeManager::windowOpacity() const
+{
+    return m_windowOpacity;
+}
+
+void ThemeManager::setWindowOpacity(double value)
+{
+    value = qBound(0.4, value, 1.0);
+    if (qFuzzyCompare(m_windowOpacity, value))
+        return;
+
+    m_windowOpacity = value;
+    m_settings->setValue("WindowOpacity", m_windowOpacity);
+
+    emit windowOpacityChanged();
+}
+
+int ThemeManager::windowRadius() const
+{
+    return m_windowRadius;
+}
+
+void ThemeManager::setWindowRadius(int value)
+{
+    value = qBound(0, value, 24);
+    if (m_windowRadius == value)
+        return;
+
+    m_windowRadius = value;
+    m_settings->setValue("WindowRadius", m_windowRadius);
+    m_settings->sync();
+
+    emit windowRadiusChanged();
+}
+
 bool ThemeManager::backgroundVisible() const
 {
     return m_backgroundVisible;
@@ -229,7 +266,7 @@ void ThemeManager::updateGtk2Config()
 
 QString ThemeManager::systemFont()
 {
-    return m_settings->value(s_systemFontName, "Noto Sans").toString();
+    return m_settings->value(s_systemFontName, "Inter").toString();
 }
 
 void ThemeManager::setSystemFont(const QString &fontFamily)
@@ -243,7 +280,7 @@ void ThemeManager::setSystemFont(const QString &fontFamily)
 
 QString ThemeManager::systemFixedFont()
 {
-    return m_settings->value(s_systemFixedFontName, "Monospace").toString();
+    return m_settings->value(s_systemFixedFontName, "JetBrains Mono").toString();
 }
 
 void ThemeManager::setSystemFixedFont(const QString &fontFamily)
diff --git a/cutefish-services/appearance/thememanager.h b/cutefish-services/appearance/thememanager.h
index 5f0a352..70d7f3a 100644
--- a/cutefish-services/appearance/thememanager.h
+++ b/cutefish-services/appearance/thememanager.h
@@ -29,6 +29,8 @@ class ThemeManager : public QObject
     Q_PROPERTY(bool isDarkMode READ isDarkMode WRITE setDarkMode NOTIFY darkModeChanged)
     Q_PROPERTY(bool darkModeDimsWallpaer READ darkModeDimsWallpaer WRITE setDarkModeDimsWallpaer NOTIFY darkModeDimsWallpaerChanged)
     Q_PROPERTY(bool blurEnabled READ blurEnabled WRITE setBlurEnabled NOTIFY blurEnabledChanged)
+    Q_PROPERTY(double windowOpacity READ windowOpacity WRITE setWindowOpacity NOTIFY windowOpacityChanged)
+    Q_PROPERTY(int windowRadius READ windowRadius WRITE setWindowRadius NOTIFY windowRadiusChanged)
     Q_PROPERTY(bool backgroundVisible READ backgroundVisible WRITE setBackgroundVisible NOTIFY backgroundVisibleChanged)
     Q_PROPERTY(QString systemFont READ systemFont WRITE setSystemFont NOTIFY systemFontChanged)
     Q_PROPERTY(QString systemFixedFont READ systemFixedFont WRITE setSystemFixedFont)
@@ -55,6 +57,15 @@ public:
     bool blurEnabled() const;
     void setBlurEnabled(bool value);
 
+    // Opacity of translucent (blurred) app windows, 0.4-1.0.
+    double windowOpacity() const;
+    void setWindowOpacity(double value);
+
+    // Corner radius of app windows in logical pixels, 0-24. KWin's
+    // decoration and rounded-corners effect read it from the same file.
+    int windowRadius() const;
+    void setWindowRadius(int value);
+
     QString systemFont();
     bool backgroundVisible() const;
     void setBackgroundVisible(bool value);
@@ -99,6 +110,8 @@ signals:
     void wallpaperChanged(QString path);
     void darkModeDimsWallpaerChanged();
     void blurEnabledChanged();
+    void windowOpacityChanged();
+    void windowRadiusChanged();
     void accentColorChanged(int accentColor);
     void backgroundVisibleChanged();
     void backgroundTypeChanged();
@@ -114,6 +127,8 @@ private:
     bool m_isDarkMode;
     bool m_darkModeDimsWallpaer;
     bool m_blurEnabled;
+    double m_windowOpacity;
+    int m_windowRadius;
     QString m_wallpaperPath;
     bool m_backgroundVisible;
     int m_backgroundType;
diff --git a/debian/changelog b/debian/changelog
index 271b205..c572417 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-core (0.8+remastered5) resolute; urgency=medium
+
+  * Appearance service: windowOpacity and windowRadius; Inter / JetBrains Mono as the default fonts
+
