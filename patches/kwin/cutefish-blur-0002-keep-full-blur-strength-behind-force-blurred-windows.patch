From 6e0bad4d4cdeb16e25b0e1787edd2d18ac4d33a7 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sat, 26 Sep 2026 18:23:06 +0600
Subject: [PATCH] blur: keep full blur strength behind force-blurred windows

A force-blurred window is made translucent by a window rule only so that
the blur shows through. The blur effect fades its result with the window's
opacity squared (meant for fade animations), so at the rule's 90 % opacity
the blurred background was mostly replaced by the sharp one. Ignore the
window's own opacity for force-blurred windows.
---
 src/plugins/blur/blur.cpp | 9 ++++++++-
 src/plugins/blur/blur.h   | 3 +++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/plugins/blur/blur.cpp b/src/plugins/blur/blur.cpp
index 1ad5aac..4fa18d4 100644
--- a/src/plugins/blur/blur.cpp
+++ b/src/plugins/blur/blur.cpp
@@ -366,8 +366,10 @@ void BlurEffect::updateBlurRegion(EffectWindow *w)
         }
     }
 
+    bool forced = false;
     if (!content.has_value() && isForceBlurred(w)) {
         content = Region(); // empty region: blur behind the whole window
+        forced = true;
     }
 
     if (w->decorationHasAlpha() && decorationSupportsBlurBehind(w)) {
@@ -378,6 +380,7 @@ void BlurEffect::updateBlurRegion(EffectWindow *w)
         BlurEffectData &data = m_windows[w];
         data.content = content;
         data.frame = frame;
+        data.forced = forced;
         if (saturation || contrast) {
             data.colorMatrix = colorTransformMatrix(saturation.value_or(1.0), contrast.value_or(1.0));
         } else {
@@ -657,7 +660,11 @@ void BlurEffect::blur(const RenderTarget &renderTarget, const RenderViewport &vi
     const QRect backgroundRect = blurShape.boundingRect();
     const QRect scaledBackgroundRect = snapToPixelGrid(scaledRect(backgroundRect, viewport.scale()));
     const QRect deviceBackgroundRect = snapToPixelGrid(viewport.mapToDeviceCoordinates(backgroundRect));
-    const auto opacity = w->opacity() * data.opacity();
+    // The blur fades with the window's opacity, so that it follows fade
+    // animations. A force-blurred window is made translucent by a window rule
+    // only so the blur shows through; fading by that opacity (squared, below)
+    // would leave mostly the sharp background, so only animations count.
+    const auto opacity = (blurInfo.forced ? 1.0 : w->opacity()) * data.opacity();
 
     // Get the effective shape that will be actually blurred. It's possible that all of it will be clipped.
     QList<RectF> effectiveShape;
diff --git a/src/plugins/blur/blur.h b/src/plugins/blur/blur.h
index 49c7859..9c2186f 100644
--- a/src/plugins/blur/blur.h
+++ b/src/plugins/blur/blur.h
@@ -52,6 +52,9 @@ struct BlurEffectData
      * Color transformation matrix (contrast, and saturation).
      */
     std::optional<QMatrix4x4> colorMatrix;
+
+    /// Blurred only because its class is in ForceBlurClasses
+    bool forced = false;
 };
 
 class BlurEffect : public KWin::Effect
