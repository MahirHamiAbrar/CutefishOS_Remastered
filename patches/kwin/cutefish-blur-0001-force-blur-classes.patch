From 7f32950afd5a1404cc23f1a56fff2b3dc1291ad5 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Fri, 25 Sep 2026 21:36:30 +0600
Subject: [PATCH] blur: add ForceBlurClasses to blur whole windows of chosen
 apps

Cutefish lets the user pick applications whose windows get a blurred
background even though they never request one through the blur protocol.
The list lives in kwinrc [Effect-blur] ForceBlurClasses and is matched
against the window's resource name or class.
---
 src/plugins/blur/blur.cpp  | 24 ++++++++++++++++++++++++
 src/plugins/blur/blur.h    |  4 ++++
 src/plugins/blur/blur.kcfg |  4 ++++
 3 files changed, 32 insertions(+)

diff --git a/src/plugins/blur/blur.cpp b/src/plugins/blur/blur.cpp
index 3c45db8..1ad5aac 100644
--- a/src/plugins/blur/blur.cpp
+++ b/src/plugins/blur/blur.cpp
@@ -37,6 +37,7 @@
 #include <QTimer>
 #include <QWindow>
 #include <cmath> // for ceil()
+#include <algorithm>
 #include <cstdlib>
 
 #include <KConfigGroup>
@@ -294,6 +295,13 @@ void BlurEffect::reconfigure(ReconfigureFlags flags)
     m_expandSize = blurOffsets[m_iterationCount - 1].expandSize;
     m_noiseStrength = BlurConfig::noiseStrength();
     m_colorMatrix = colorTransformMatrix(BlurConfig::saturation() / 100.0, 1.0);
+    m_forceBlurClasses.clear();
+    for (const QString &windowClass : BlurConfig::forceBlurClasses()) {
+        m_forceBlurClasses.insert(windowClass.trimmed().toLower());
+    }
+    for (EffectWindow *window : effects->stackingOrder()) {
+        updateBlurRegion(window);
+    }
     for (auto &[window, data] : m_windows) {
         data.blurItem->setPixelsToExpandRepaintsBelowOpaqueRegions(m_expandSize);
     }
@@ -302,6 +310,18 @@ void BlurEffect::reconfigure(ReconfigureFlags flags)
     effects->addRepaintFull();
 }
 
+bool BlurEffect::isForceBlurred(const EffectWindow *w) const
+{
+    if (m_forceBlurClasses.isEmpty() || !w->isNormalWindow()) {
+        return false;
+    }
+    // windowClass() is "<resource name> <resource class>"; match either part.
+    const QStringList parts = w->windowClass().toLower().split(QLatin1Char(' '), Qt::SkipEmptyParts);
+    return std::ranges::any_of(parts, [this](const QString &part) {
+        return m_forceBlurClasses.contains(part);
+    });
+}
+
 void BlurEffect::updateBlurRegion(EffectWindow *w)
 {
     std::optional<Region> content;
@@ -346,6 +366,10 @@ void BlurEffect::updateBlurRegion(EffectWindow *w)
         }
     }
 
+    if (!content.has_value() && isForceBlurred(w)) {
+        content = Region(); // empty region: blur behind the whole window
+    }
+
     if (w->decorationHasAlpha() && decorationSupportsBlurBehind(w)) {
         frame = decorationBlurRegion(w);
     }
diff --git a/src/plugins/blur/blur.h b/src/plugins/blur/blur.h
index a0c9716..49c7859 100644
--- a/src/plugins/blur/blur.h
+++ b/src/plugins/blur/blur.h
@@ -13,6 +13,8 @@
 
 #include <QList>
 
+#include <QSet>
+
 #include <unordered_map>
 
 namespace KWin
@@ -95,6 +97,7 @@ private:
     bool decorationSupportsBlurBehind(const EffectWindow *w) const;
     bool shouldBlur(const EffectWindow *w, int mask, const WindowPaintData &data) const;
     void updateBlurRegion(EffectWindow *w);
+    bool isForceBlurred(const EffectWindow *w) const;
     void blur(const RenderTarget &renderTarget, const RenderViewport &viewport, EffectWindow *w, int mask, const Region &deviceRegion, WindowPaintData &data);
     GLTexture *ensureNoiseTexture();
 
@@ -158,6 +161,7 @@ private:
     int m_offset;
     int m_expandSize;
     int m_noiseStrength;
+    QSet<QString> m_forceBlurClasses;
 
     struct OffsetStruct
     {
diff --git a/src/plugins/blur/blur.kcfg b/src/plugins/blur/blur.kcfg
index c8d827a..639a01c 100644
--- a/src/plugins/blur/blur.kcfg
+++ b/src/plugins/blur/blur.kcfg
@@ -14,5 +14,9 @@
         <entry name="Saturation" type="Int">
             <default>150</default>
         </entry>
+        <!-- Cutefish: window classes blurred behind as a whole even if they never ask for it. -->
+        <entry name="ForceBlurClasses" type="StringList">
+            <default></default>
+        </entry>
     </group>
 </kcfg>
