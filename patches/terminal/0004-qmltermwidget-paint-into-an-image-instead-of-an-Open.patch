From c7b74b81d44801f3d6f5159292f16066a450d050 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sun, 27 Sep 2026 15:09:37 +0600
Subject: [PATCH 4/4] qmltermwidget: paint into an image instead of an OpenGL
 framebuffer (stale text and colour blocks under Neovim)

---
 debian/changelog                      | 6 ++++++
 qmltermwidget/lib/TerminalDisplay.cpp | 6 +++++-
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/debian/changelog b/debian/changelog
index cac4ab4..cf3d27b 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-terminal (0.7+remastered4) resolute; urgency=medium
+
+  * qmltermwidget: paint into an image instead of an OpenGL framebuffer (stale text and colour blocks under Neovim)
+
+ -- Cutefish Remastered <remastered@localhost>  Sun, 27 Sep 2026 15:09:36 +0600
+
 cutefish-terminal (0.7+remastered3) resolute; urgency=medium
 
   * qmltermwidget: consume DCS/SOS/PM/APC string sequences instead of printing their payload (Neovim's XTGETTCAP and snacks.nvim's graphics queries corrupted the screen)
diff --git a/qmltermwidget/lib/TerminalDisplay.cpp b/qmltermwidget/lib/TerminalDisplay.cpp
index 4de186c..88520c3 100644
--- a/qmltermwidget/lib/TerminalDisplay.cpp
+++ b/qmltermwidget/lib/TerminalDisplay.cpp
@@ -476,7 +476,11 @@ TerminalDisplay::TerminalDisplay(QQuickItem *parent)
   _scrollBar->setVisible(false);
   connect(_scrollBar, SIGNAL(valueChanged(int)), this, SIGNAL(scrollbarParamsChanged(int)));
 
-  setUseFBORendering(true);
+  // Image, not FramebufferObject: through the OpenGL paint engine the
+  // transparent background (Terminal draws its own, translucent one) wasn't
+  // cleared on partial repaints, so full-screen programs like Neovim left
+  // stale text, colour blocks and a diagonal triangle seam behind.
+  setUseFBORendering(false);
 
 //  setFocusPolicy( Qt::WheelFocus );
 
-- 
