index 0000000..6f3c5e4
--- /dev/null
+++ b/qmltermwidget/lib/proxysettings.h
@@ -0,0 +1,78 @@
+/*
+ * Session proxy for new shells.
+ *
+ * Upstream Terminal includes this header from a framework version that has not
+ * been published yet. This local copy reads the same settings as the session's
+ * NetworkProxyManager (core/session/networkproxymanager.cpp): QSettings
+ * "cutefishos"/"network", manual proxy when ProxyFlag == 2. When the framework
+ * ships its own ProxySettings, delete this file.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * any later version.
+ */
+
+#ifndef PROXYSETTINGS_H
+#define PROXYSETTINGS_H
+
+#include <QMap>
+#include <QSettings>
+#include <QString>
+#include <QStringList>
+
+struct ProxySettings
+{
+    bool manual = false;
+    bool useSameProxy = false;
+    QString httpHost, httpPort, ftpHost, ftpPort;
+
+    static ProxySettings load()
+    {
+        QSettings s(QSettings::UserScope, QStringLiteral("cutefishos"), QStringLiteral("network"));
+        ProxySettings p;
+        p.manual = s.value(QStringLiteral("ProxyFlag"), 0).toInt() == 2;
+        p.useSameProxy = s.value(QStringLiteral("UseSameProxy"), false).toBool();
+        p.httpHost = s.value(QStringLiteral("HttpProxy")).toString();
+        p.httpPort = s.value(QStringLiteral("HttpProxyPort")).toString();
+        p.ftpHost = s.value(QStringLiteral("FtpProxy")).toString();
+        p.ftpPort = s.value(QStringLiteral("FtpProxyPort")).toString();
+        return p;
+    }
+};
+
+namespace ProxyEnvironment
+{
+//! Every variable a shell might have inherited; the ones not in variables() are unset.
+inline QStringList names()
+{
+    return {QStringLiteral("HTTP_PROXY"), QStringLiteral("HTTPS_PROXY"), QStringLiteral("FTP_PROXY"),
+            QStringLiteral("ALL_PROXY"), QStringLiteral("NO_PROXY"), QStringLiteral("http_proxy"),
+            QStringLiteral("https_proxy"), QStringLiteral("ftp_proxy"), QStringLiteral("all_proxy"),
+            QStringLiteral("no_proxy")};
+}
+
+inline QMap<QString, QString> variables(const ProxySettings &p)
+{
+    QMap<QString, QString> env;
+    if (!p.manual)
+        return env;
+
+    const QString http = QStringLiteral("http://%1:%2/").arg(p.httpHost, p.httpPort);
+    const QString ftp = p.useSameProxy ? http : QStringLiteral("http://%1:%2/").arg(p.ftpHost, p.ftpPort);
+
+    if (!p.httpHost.isEmpty() && !p.httpPort.isEmpty()) {
+        for (const char *name : {"HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy"})
+            env.insert(QString::fromLatin1(name), http);
+    }
+    if ((p.useSameProxy && !p.httpHost.isEmpty()) || (!p.ftpHost.isEmpty() && !p.ftpPort.isEmpty())) {
+        env.insert(QStringLiteral("FTP_PROXY"), ftp);
+        env.insert(QStringLiteral("ftp_proxy"), ftp);
+    }
+    env.insert(QStringLiteral("NO_PROXY"), QStringLiteral("localhost,127.0.0.0/8,::1"));
+    env.insert(QStringLiteral("no_proxy"), QStringLiteral("localhost,127.0.0.0/8,::1"));
+    return env;
+}
+} // namespace ProxyEnvironment
+
+#endif // PROXYSETTINGS_H
