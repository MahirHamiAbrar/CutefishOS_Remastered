+# Linked into the qmltermwidget QML plugin (a shared module) too.
+set_target_properties(cutefish-framework-applications PROPERTIES POSITION_INDEPENDENT_CODE ON)
 
 # Where QML modules go, so the terminal widget plugin lands next to FishUI.
