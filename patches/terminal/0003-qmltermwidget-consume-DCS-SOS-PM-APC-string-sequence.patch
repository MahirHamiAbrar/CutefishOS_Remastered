From cb578575a2cc696e4e2e4c66cdb39dc02b816d44 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sun, 27 Sep 2026 14:50:00 +0600
Subject: [PATCH 3/3] qmltermwidget: consume DCS/SOS/PM/APC string sequences
 instead of printing their payload (Neovim's XTGETTCAP and snacks.nvim's
 graphics queries corrupted the screen)

---
 debian/changelog                     | 6 ++++++
 qmltermwidget/lib/Vt102Emulation.cpp | 9 +++++++--
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/debian/changelog b/debian/changelog
index 1882d80..cac4ab4 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-terminal (0.7+remastered3) resolute; urgency=medium
+
+  * qmltermwidget: consume DCS/SOS/PM/APC string sequences instead of printing their payload (Neovim's XTGETTCAP and snacks.nvim's graphics queries corrupted the screen)
+
+ -- Cutefish Remastered <remastered@localhost>  Sun, 27 Sep 2026 14:50:00 +0600
+
 cutefish-terminal (0.7+remastered2) resolute; urgency=medium
 
   * Default font: Fantasque Sans Mono
diff --git a/qmltermwidget/lib/Vt102Emulation.cpp b/qmltermwidget/lib/Vt102Emulation.cpp
index be82181..54a915b 100644
--- a/qmltermwidget/lib/Vt102Emulation.cpp
+++ b/qmltermwidget/lib/Vt102Emulation.cpp
@@ -255,7 +255,12 @@ void Vt102Emulation::initTokenizer()
 #define epe( )     (p >=  3  && s[2] == '!')
 #define egt( )     (p >=  3  && s[2] == '>')
 #define esp( )     (p ==  4  && s[3] == ' ')
-#define Xpe        (tokenBufferPos >= 2 && tokenBuffer[1] == ']')
+// String sequences run up to BEL or ST: OSC "ESC]" (window attributes), and
+// DCS "ESC P", SOS "ESC X", PM "ESC ^", APC "ESC _", whose payload is dropped.
+// Without the latter, their payload was printed as text: Neovim's XTGETTCAP
+// query and snacks.nvim's graphics query left garbage all over the screen.
+#define Xpe        (tokenBufferPos >= 2 && (tokenBuffer[1] == ']' || tokenBuffer[1] == 'P' || \
+                    tokenBuffer[1] == 'X' || tokenBuffer[1] == '^' || tokenBuffer[1] == '_'))
 #define Xte        (Xpe      && (cc ==  7 || (prevCC == 27 && cc == 92) )) // 27, 92 => "\e\\" (ST, String Terminator)
 #define ces(C)     (cc < 256 && (charClass[cc] & (C)) == (C) && !Xte)
 
@@ -301,7 +306,7 @@ void Vt102Emulation::receiveChar(wchar_t cc)
     if (lec(1,0,ESC)) { return; }
     if (lec(1,0,ESC+128)) { s[0] = ESC; receiveChar('['); return; }
     if (les(2,1,GRP)) { return; }
-    if (Xte         ) { processWindowAttributeChange(); resetTokenizer(); return; }
+    if (Xte         ) { if (s[1] == ']') processWindowAttributeChange(); resetTokenizer(); return; }
     if (Xpe         ) { prevCC = cc; return; }
     if (lec(3,2,'?')) { return; }
     if (lec(3,2,'>')) { return; }
-- 
