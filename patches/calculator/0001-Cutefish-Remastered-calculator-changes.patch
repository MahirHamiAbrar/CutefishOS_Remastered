From 542629e2c445dd73c05a99520e7185d63ada4ac2 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Fri, 25 Sep 2026 22:14:32 +0600
Subject: [PATCH 1/2] Cutefish Remastered: calculator changes

- Port to Qt 6
---
 CMakeLists.txt       | 12 ++++++------
 debian/changelog     |  6 ++++++
 debian/compat        |  1 -
 debian/control       | 27 ++++++++++++---------------
 debian/rules         |  5 -----
 engine/evaluator.cpp |  2 +-
 main.cpp             |  3 ---
 7 files changed, 25 insertions(+), 31 deletions(-)
 delete mode 100644 debian/compat

diff --git a/CMakeLists.txt b/CMakeLists.txt
index aab3d1b..6b2dc95 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,11 +7,11 @@ set(CMAKE_INCLUDE_CURRENT_DIR ON)
 set(CMAKE_AUTOUIC ON)
 set(CMAKE_AUTOMOC ON)
 set(CMAKE_AUTORCC ON)
-set(CMAKE_CXX_STANDARD 11)
+set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
 set(QT Core Gui Quick QuickControls2 LinguistTools)
-find_package(Qt5 REQUIRED ${QT})
+find_package(Qt6 REQUIRED ${QT})
 if (MSVC)
     # fix warning C4819: The file contains a character that cannot be represented in the current code page (936).
     # Save the file in Unicode format to prevent data loss
@@ -33,15 +33,15 @@ set(RESOURCES
 
 add_executable(${PROJECT_NAME} ${SRCS} ${RESOURCES})
 target_link_libraries(${PROJECT_NAME}
-        Qt5::Core
-        Qt5::Quick
-        Qt5::QuickControls2
+        Qt6::Core
+        Qt6::Quick
+        Qt6::QuickControls2
 )
 if (MSVC)
     # do nothing
 else()
     file(GLOB TS_FILES translations/*.ts)
-    qt5_create_translation(QM_FILES ${TS_FILES})
+    qt6_add_translation(QM_FILES ${TS_FILES})
     add_custom_target(translations DEPENDS ${QM_FILES} SOURCES ${TS_FILES})
     add_dependencies(${PROJECT_NAME} translations)
 endif ()
