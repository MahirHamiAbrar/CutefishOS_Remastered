From 8fbfde60efa22f2395a189fe4c8f02579904db72 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sun, 27 Sep 2026 23:39:18 +0600
Subject: [PATCH 8/8] Tested in the live session: pointer speed written only on
 drag (opening Mouse set it to the minimum); time zone, NTP and clock changes
 may ask polkit for a password; time zone dialog content below its header,
 readable search results; fixed-size keyboard layout buttons (recursive
 layout); formats combo box snaps back on failure; depend on pkexec

---
 debian/changelog                    |  6 ++++++
 debian/control                      |  3 ++-
 src/datetime/time.cpp               |  6 ++++++
 src/datetime/timezonemap.cpp        |  4 ++++
 src/qml/About/Main.qml              |  1 +
 src/qml/Cursor/Main.qml             |  5 ++++-
 src/qml/DateTime/TimeZoneDialog.qml | 10 +++++++++-
 src/qml/LanguagePage.qml            | 13 ++++++++++---
 src/qml/Notification/Main.qml       |  2 +-
 9 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/debian/changelog b/debian/changelog
index 9edea72..a40fc38 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-settings (0.8+remastered10) resolute; urgency=medium
+
+  * Tested in the live session: pointer speed written only on drag (opening Mouse set it to the minimum); time zone, NTP and clock changes may ask polkit for a password; time zone dialog content below its header, readable search results; fixed-size keyboard layout buttons (recursive layout); formats combo box snaps back on failure; depend on pkexec
+
+ -- Cutefish Remastered <remastered@localhost>  Sun, 27 Sep 2026 23:39:18 +0600
+
 cutefish-settings (0.8+remastered9) resolute; urgency=medium
 
   * Fix Background, Mouse and User layouts; per-app notifications; time zone picks the nearest city; formats never stuck; icon buttons for keyboard layouts; battery health bar; About sections; sidebar search; cached, animated pages; blur controls for cutefish_blur (strength 1-20, saturation)
diff --git a/debian/control b/debian/control
index c8ed97c..6a2fc53 100644
--- a/debian/control
+++ b/debian/control
@@ -22,7 +22,8 @@ Homepage: https://cutefishos.com
 
 Package: cutefish-settings
 Architecture: any
-Depends: qml6-module-qtquick-controls,
+Depends: pkexec,
+         qml6-module-qtquick-controls,
          qml6-module-qtquick,
          qml6-module-qtquick-layouts,
          qml6-module-qt-labs-platform,
diff --git a/src/datetime/time.cpp b/src/datetime/time.cpp
index 73cb861..89c25a0 100644
--- a/src/datetime/time.cpp
+++ b/src/datetime/time.cpp
@@ -61,6 +61,9 @@ void Time::save()
     OrgFreedesktopTimedate1Interface iface(QStringLiteral("org.freedesktop.timedate1"),
                                            QStringLiteral("/org/freedesktop/timedate1"),
                                            QDBusConnection::systemBus());
+    // Without this flag polkit refuses instead of asking for the password
+    // ("interactive authentication has not been enabled by the calling program").
+    iface.setInteractiveAuthorizationAllowed(true);
     // Only the sync switch: the clock is set explicitly with setDateTime().
     // (This used to also set the clock from currentTime/currentDate, which
     // nothing ever filled in, so turning sync off set a garbage time.)
@@ -78,6 +81,9 @@ bool Time::setDateTime(const QString &date, const QString &time)
     OrgFreedesktopTimedate1Interface iface(QStringLiteral("org.freedesktop.timedate1"),
                                            QStringLiteral("/org/freedesktop/timedate1"),
                                            QDBusConnection::systemBus());
+    // Without this flag polkit refuses instead of asking for the password
+    // ("interactive authentication has not been enabled by the calling program").
+    iface.setInteractiveAuthorizationAllowed(true);
     // Absolute time in microseconds since the epoch; interactive for polkit.
     auto reply = iface.SetTime(userTime.toMSecsSinceEpoch() * 1000, false, true);
     reply.waitForFinished();
diff --git a/src/datetime/timezonemap.cpp b/src/datetime/timezonemap.cpp
index 1dd0972..4c30bca 100644
--- a/src/datetime/timezonemap.cpp
+++ b/src/datetime/timezonemap.cpp
@@ -134,6 +134,10 @@ void TimeZoneMap::setTimeZone(QString value)
                                                    QStringLiteral("/org/freedesktop/timedate1"),
                                                    QDBusConnection::systemBus());
 
+    // Without this flag polkit refuses instead of asking for the password
+    // ("interactive authentication has not been enabled by the calling program").
+    iface.setInteractiveAuthorizationAllowed(true);
+
     auto reply = iface.SetTimezone(value, true);
     reply.waitForFinished();
 
diff --git a/src/qml/About/Main.qml b/src/qml/About/Main.qml
index ae29c0b..356c13d 100644
--- a/src/qml/About/Main.qml
+++ b/src/qml/About/Main.qml
@@ -98,6 +98,7 @@ ItemPage {
                 StandardItem {
                     key: qsTr("Operating System")
                     value: about.prettyProductName
+                    visible: value !== about.version
                 }
 
                 StandardItem {
diff --git a/src/qml/Cursor/Main.qml b/src/qml/Cursor/Main.qml
index 95612d5..9cf2b05 100644
--- a/src/qml/Cursor/Main.qml
+++ b/src/qml/Cursor/Main.qml
@@ -130,7 +130,10 @@ ItemPage {
 
                         Component.onCompleted: init()
 
-                        onValueChanged: {
+                        // Only the user's drags write the speed. onValueChanged also
+                        // fired for the initial value (from: 1), so just opening
+                        // this page set every mouse to the slowest speed (-1.0).
+                        onMoved: {
                             mouse.pointerAcceleration = Math.round(((value - 6) * 0.2) * 10) / 10
                         }
                     }
diff --git a/src/qml/DateTime/TimeZoneDialog.qml b/src/qml/DateTime/TimeZoneDialog.qml
index 4a244a4..ea23ed1 100644
--- a/src/qml/DateTime/TimeZoneDialog.qml
+++ b/src/qml/DateTime/TimeZoneDialog.qml
@@ -34,7 +34,8 @@ FishUI.Window {
 
     background.color: FishUI.Theme.secondBackgroundColor
     background.opacity: FishUI.Theme.blurEnabled ? 0.5 : 1
-    contentTopMargin: 0
+    // The content starts below the header: the header (window drag area and
+    // buttons) sits above it and took the clicks meant for the search field.
 
     onWidthChanged: control.reset()
     onHeightChanged: control.reset()
@@ -196,6 +197,13 @@ FishUI.Window {
                     width: ListView.view.width
                     text: modelData.city + " — " + modelData.country + "  (" + modelData.zone + ")"
                     highlighted: ListView.isCurrentItem
+                    // The fallback (Basic) style drew this text almost white.
+                    contentItem: Label {
+                        text: parent.text
+                        elide: Text.ElideRight
+                        verticalAlignment: Text.AlignVCenter
+                        color: FishUI.Theme.textColor
+                    }
                     onClicked: control.pick(modelData)
                     Keys.onReturnPressed: control.pick(modelData)
                 }
diff --git a/src/qml/LanguagePage.qml b/src/qml/LanguagePage.qml
index b14949b..77a2af8 100644
--- a/src/qml/LanguagePage.qml
+++ b/src/qml/LanguagePage.qml
@@ -44,7 +44,11 @@ ItemPage {
 
     Settings.Language {
         id: language
-        onFormatsFailed: (message) => formatsError.text = message
+        onFormatsFailed: (message) => {
+            formatsError.text = message
+            // Picking an entry broke the combo box's binding; put it back.
+            formatsCombo.currentIndex = Qt.binding(() => language.currentFormats)
+        }
     }
 
     Settings.KeyboardLayouts {
@@ -91,6 +95,7 @@ ItemPage {
                     }
 
                     ComboBox {
+                        id: formatsCombo
                         Layout.fillWidth: true
                         model: language.formats
                         currentIndex: language.currentFormats
@@ -155,8 +160,10 @@ ItemPage {
                         Layout.fillWidth: true
                         spacing: 0
 
-                        // The three buttons share at most a fifth of the row.
-                        readonly property real buttonSize: Math.min(32, width * 0.2 / 3)
+                        // Small icon buttons: together well under a fifth of the
+                        // row. (A size derived from the row's width made the
+                        // layout rearrange recursively.)
+                        readonly property real buttonSize: 28
 
                         Label {
                             text: modelData.name
diff --git a/src/qml/Notification/Main.qml b/src/qml/Notification/Main.qml
