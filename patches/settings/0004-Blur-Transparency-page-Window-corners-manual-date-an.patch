+    return (index > -1) ? timeZone.mid(index + 1).replace('_', ' ') : timeZone;
+}
+
+QVariantList TimeZoneMap::search(const QString &text) const
+{
+    QVariantList result;
+    const QString needle = text.trimmed();
+    if (needle.isEmpty())
+        return result;
+
+    for (const TimeZoneItem *item : m_list) {
+        const QString city = localeTimeZoneName(item->timeZone);
+        const QString country = QLocale::territoryToString(QLocale::codeToTerritory(item->country));
+        if (!city.contains(needle, Qt::CaseInsensitive)
+                && !item->timeZone.contains(needle, Qt::CaseInsensitive)
+                && !country.contains(needle, Qt::CaseInsensitive))
+            continue;
+
+        result.append(QVariantMap {
+            { QStringLiteral("zone"), item->timeZone },
+            { QStringLiteral("city"), city },
+            { QStringLiteral("country"), country },
+            { QStringLiteral("x"), convert_longitude_to_x(item->longitude) },
+            { QStringLiteral("y"), convert_latitude_to_y(item->latitude) },
+        });
+        if (result.size() >= 50)
+            break;
+    }
+    return result;
+}
+
+void TimeZoneMap::select(const QString &zone)
+{
+    m_currentList = { zone };
+    emit availableListChanged();
 }
 
 void TimeZoneMap::initDatas()
