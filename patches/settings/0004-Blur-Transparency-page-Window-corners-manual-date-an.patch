diff --git a/src/qml/Blur/Main.qml b/src/qml/Blur/Main.qml
new file mode 100644
index 0000000..571d46f
--- /dev/null
+++ b/src/qml/Blur/Main.qml
@@ -0,0 +1,302 @@
+/*
+ * Cutefish Remastered: blur and transparency, with the finer controls KDE
+ * Plasma offers (blur and noise strength, per-app opacity, KWin's
+ * Translucency effect).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * any later version.
+ */
+
+import QtQuick 2.4
+import QtQuick.Controls 2.4
+import QtQuick.Layouts 1.3
+
+import Cutefish.Settings 1.0
+import Cutefish.Appearance 1.0 as FrameworkAppearance
+import FishUI 1.0 as FishUI
+import "../"
+
+ItemPage {
+    headerTitle: qsTr("Blur & Transparency")
+
+    WindowEffects {
+        id: windowEffects
+    }
+
+    FrameworkAppearance.Appearance {
+        id: appearance
+    }
+
+    // A label, a slider and its value. Changes apply while dragging.
+    component SliderRow: RowLayout {
+        id: _row
+        property alias text: _label.text
+        property alias from: _slider.from
+        property alias to: _slider.to
+        property alias stepSize: _slider.stepSize
+        // Follows the setting; a Binding survives the slider being dragged,
+        // so external changes (Reset) still show.
+        property real value
+        property string suffix: "%"
+        property real displayScale: 1
+        signal moved(real value)
+
+        Layout.fillWidth: true
+        spacing: FishUI.Units.largeSpacing
+
+        Label {
+            id: _label
+            Layout.preferredWidth: 170
+            wrapMode: Text.WordWrap
+        }
+
+        Slider {
+            id: _slider
+            Layout.fillWidth: true
+            snapMode: Slider.SnapAlways
+            onMoved: _row.moved(value)
+
+            Binding on value {
+                value: _row.value
+                when: !_slider.pressed
+                restoreMode: Binding.RestoreNone
+            }
+        }
+
+        Label {
+            Layout.preferredWidth: 44
+            horizontalAlignment: Text.AlignRight
+            text: Math.round(_slider.value * displayScale) + suffix
+            color: FishUI.Theme.disabledTextColor
+            font.features: { "tnum": 1 }
+        }
+    }
+
+    component SwitchRow: RowLayout {
+        id: _switchRow
+        property alias text: _switchLabel.text
+        property bool checked
+        signal toggled(bool checked)
+
+        Layout.fillWidth: true
+        spacing: FishUI.Units.largeSpacing
+
+        Label {
+            id: _switchLabel
+            Layout.fillWidth: true
+            Layout.alignment: Qt.AlignVCenter
+            wrapMode: Text.WordWrap
+        }
+
+        Switch {
+            id: _switch
+            rightPadding: 0
+            Layout.alignment: Qt.AlignVCenter | Qt.AlignRight
+            onClicked: _switchRow.toggled(checked)
+
+            Binding on checked {
+                value: _switchRow.checked
+                restoreMode: Binding.RestoreNone
+            }
+        }
+    }
+
+    Scrollable {
+        anchors.fill: parent
+        contentHeight: layout.implicitHeight
+
+        ColumnLayout {
+            id: layout
+            anchors.fill: parent
+            spacing: FishUI.Units.largeSpacing * 2
+
+            RoundedItem {
+                Label {
+                    text: qsTr("Windows")
+                    color: FishUI.Theme.disabledTextColor
+                }
+
+                SwitchRow {
+                    text: qsTr("Blur behind windows, panels and menus")
+                    checked: appearance.blurEnabled
+                    onToggled: (checked) => appearance.setBlurEnabled(checked)
+                }
+
+                HorizontalDivider {}
+
+                SliderRow {
+                    enabled: appearance.blurEnabled
+                    text: qsTr("Window opacity")
+                    from: 0.4
+                    to: 1.0
+                    stepSize: 0.05
+                    displayScale: 100
+                    value: appearance.windowOpacity
+                    onMoved: (value) => appearance.setWindowOpacity(value)
+                }
+
+                Label {
+                    text: qsTr("How much of the desktop shows through Cutefish apps. Lower is more transparent.")
+                    color: FishUI.Theme.disabledTextColor
+                    wrapMode: Text.WordWrap
+                    Layout.fillWidth: true
+                }
+            }
+
+            RoundedItem {
+                enabled: appearance.blurEnabled
+
+                Label {
+                    text: qsTr("Blur")
+                    color: FishUI.Theme.disabledTextColor
+                }
+
+                SliderRow {
+                    text: qsTr("Blur strength")
+                    from: 1
+                    to: 15
+                    stepSize: 1
+                    suffix: ""
+                    value: windowEffects.blurStrength
+                    onMoved: (value) => windowEffects.blurStrength = value
+                }
+
+                SliderRow {
+                    text: qsTr("Noise strength")
+                    from: 0
+                    to: 14
+                    stepSize: 1
+                    suffix: ""
+                    value: windowEffects.noiseStrength
+                    onMoved: (value) => windowEffects.noiseStrength = value
+                }
+            }
+
+            RoundedItem {
+                enabled: appearance.blurEnabled
+
+                Label {
+                    text: qsTr("Always blur these apps")
+                    color: FishUI.Theme.disabledTextColor
+                }
+
+                Label {
+                    text: qsTr("For apps that don't ask for blur themselves (Firefox, LibreOffice, GTK apps). Their whole window becomes translucent with the desktop blurred behind it.")
+                    color: FishUI.Theme.disabledTextColor
+                    wrapMode: Text.WordWrap
+                    Layout.fillWidth: true
+                }
+
+                Repeater {
+                    model: windowEffects.forcedApps
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: FishUI.Units.largeSpacing
+
+                        Image {
+                            width: 24
+                            height: 24
+                            sourceSize: Qt.size(24, 24)
+                            source: "image://icontheme/" + modelData.icon
+                        }
+
+                        Label {
+                            text: modelData.name
+                            Layout.fillWidth: true
+                            elide: Text.ElideRight
+                        }
+
+                        Button {
+                            text: qsTr("Remove")
+                            onClicked: windowEffects.removeForcedApp(modelData.windowClass)
+                        }
+                    }
+                }
+
+                RowLayout {
+                    spacing: FishUI.Units.largeSpacing
+
+                    ComboBox {
+                        id: blurAppCombo
+                        Layout.fillWidth: true
+                        model: windowEffects.availableApps
+                        textRole: "name"
+                    }
+
+                    Button {
+                        text: qsTr("Add")
+                        enabled: blurAppCombo.currentIndex >= 0
+                        onClicked: windowEffects.addForcedApp(windowEffects.availableApps[blurAppCombo.currentIndex].windowClass)
+                    }
+                }
+
+                HorizontalDivider {}
+
+                SliderRow {
+                    text: qsTr("Opacity when active")
+                    from: 40
+                    to: 100
+                    stepSize: 5
+                    value: windowEffects.forcedActiveOpacity
+                    onMoved: (value) => windowEffects.forcedActiveOpacity = value
+                }
+
+                SliderRow {
+                    text: qsTr("Opacity when inactive")
+                    from: 40
+                    to: 100
+                    stepSize: 5
+                    value: windowEffects.forcedInactiveOpacity
+                    onMoved: (value) => windowEffects.forcedInactiveOpacity = value
+                }
+            }
+
+            RoundedItem {
+                Label {
+                    text: qsTr("Translucency")
+                    color: FishUI.Theme.disabledTextColor
+                }
+
+                SwitchRow {
+                    text: qsTr("Make every window translucent while inactive or being moved")
+                    checked: windowEffects.translucencyEnabled
+                    onToggled: (checked) => windowEffects.translucencyEnabled = checked
+                }
+
+                SliderRow {
+                    enabled: windowEffects.translucencyEnabled
+                    text: qsTr("Inactive windows")
+                    from: 20
+                    to: 100
+                    stepSize: 5
+                    value: windowEffects.inactiveOpacity
+                    onMoved: (value) => windowEffects.inactiveOpacity = value
+                }
+
+                SliderRow {
+                    enabled: windowEffects.translucencyEnabled
+                    text: qsTr("Moving or resizing windows")
+                    from: 20
+                    to: 100
+                    stepSize: 5
+                    value: windowEffects.moveResizeOpacity
+                    onMoved: (value) => windowEffects.moveResizeOpacity = value
+                }
+            }
+
+            Button {
+                Layout.alignment: Qt.AlignRight
+                Layout.bottomMargin: FishUI.Units.largeSpacing * 2
+                text: qsTr("Reset to defaults")
+                onClicked: {
+                    appearance.setBlurEnabled(true)
+                    appearance.setWindowOpacity(0.7)
+                    windowEffects.resetDefaults()
+                }
+            }
+        }
+    }
+}
