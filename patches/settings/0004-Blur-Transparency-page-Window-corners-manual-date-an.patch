+
+void WindowEffects::reconfigureEffect(const QString &name)
+{
+    QDBusMessage message = QDBusMessage::createMethodCall(
+        QStringLiteral("org.kde.KWin"), QStringLiteral("/Effects"),
+        QStringLiteral("org.kde.kwin.Effects"), QStringLiteral("reconfigureEffect"));
+    message << name;
+    QDBusConnection::sessionBus().asyncCall(message);
+}
+
+int WindowEffects::noiseStrength() const
+{
+    return kwinConfig()->group(QStringLiteral("Effect-blur")).readEntry("NoiseStrength", DefaultNoiseStrength);
+}
+
+void WindowEffects::setNoiseStrength(int strength)
+{
+    strength = qBound(0, strength, 14);
+    if (strength == noiseStrength())
+        return;
+
+    KConfigGroup group = kwinConfig()->group(QStringLiteral("Effect-blur"));
+    group.writeEntry("NoiseStrength", strength);
+    group.sync();
+    reconfigureEffect(QStringLiteral("blur"));
+    emit noiseStrengthChanged();
+}
+
+int WindowEffects::forcedActiveOpacity() const
+{
+    return kwinConfig()->group(QStringLiteral("Cutefish")).readEntry("ForcedAppActiveOpacity", DefaultActiveOpacity);
+}
+
+void WindowEffects::setForcedActiveOpacity(int percent)
+{
+    setForcedOpacity("ForcedAppActiveOpacity", percent);
+}
+
+int WindowEffects::forcedInactiveOpacity() const
+{
+    return kwinConfig()->group(QStringLiteral("Cutefish")).readEntry("ForcedAppInactiveOpacity", DefaultInactiveOpacity);
+}
+
+void WindowEffects::setForcedInactiveOpacity(int percent)
+{
+    setForcedOpacity("ForcedAppInactiveOpacity", percent);
+}
+
+void WindowEffects::setForcedOpacity(const char *key, int percent)
+{
+    percent = qBound(20, percent, 100);
+    KConfigGroup group = kwinConfig()->group(QStringLiteral("Cutefish"));
+    if (group.readEntry(key, -1) == percent)
+        return;
+
+    group.writeEntry(key, percent);
+    group.sync();
+    setForcedClasses(forcedClasses()); // rewrites the window rules
+    emit forcedOpacityChanged();
+}
+
+bool WindowEffects::translucencyEnabled() const
+{
+    return kwinConfig()->group(QStringLiteral("Plugins")).readEntry("translucencyEnabled", false);
+}
+
+void WindowEffects::setTranslucencyEnabled(bool enabled)
+{
+    if (enabled == translucencyEnabled())
+        return;
+
+    KConfigGroup group = kwinConfig()->group(QStringLiteral("Plugins"));
+    group.writeEntry("translucencyEnabled", enabled);
+    group.sync();
+
+    // reconfigure alone doesn't load or unload an effect.
+    QDBusMessage message = QDBusMessage::createMethodCall(
+        QStringLiteral("org.kde.KWin"), QStringLiteral("/Effects"),
+        QStringLiteral("org.kde.kwin.Effects"),
+        enabled ? QStringLiteral("loadEffect") : QStringLiteral("unloadEffect"));
+    message << QStringLiteral("translucency");
+    QDBusConnection::sessionBus().asyncCall(message);
+    emit translucencyChanged();
+}
+
+int WindowEffects::inactiveOpacity() const
+{
+    return kwinConfig()->group(QStringLiteral("Effect-translucency")).readEntry("Inactive", DefaultInactive);
+}
+
+void WindowEffects::setInactiveOpacity(int percent)
+{
+    writeTranslucency("Inactive", percent);
+}
+
+int WindowEffects::moveResizeOpacity() const
+{
+    return kwinConfig()->group(QStringLiteral("Effect-translucency")).readEntry("MoveResize", DefaultMoveResize);
+}
+
+void WindowEffects::setMoveResizeOpacity(int percent)
+{
+    writeTranslucency("MoveResize", percent);
+}
+
+void WindowEffects::writeTranslucency(const char *key, int percent)
+{
+    percent = qBound(20, percent, 100);
+    KConfigGroup group = kwinConfig()->group(QStringLiteral("Effect-translucency"));
+    group.writeEntry(key, percent);
+    group.sync();
+    reconfigureEffect(QStringLiteral("translucency"));
+    emit translucencyChanged();
+}
+
+void WindowEffects::resetDefaults()
+{
+    KConfigGroup blur = kwinConfig()->group(QStringLiteral("Effect-blur"));
+    blur.writeEntry("BlurStrength", DefaultBlurStrength);
+    blur.writeEntry("NoiseStrength", DefaultNoiseStrength);
+    blur.sync();
+
+    KConfigGroup cutefish = kwinConfig()->group(QStringLiteral("Cutefish"));
+    cutefish.writeEntry("ForcedAppActiveOpacity", DefaultActiveOpacity);
+    cutefish.writeEntry("ForcedAppInactiveOpacity", DefaultInactiveOpacity);
+    cutefish.sync();
+
+    KConfigGroup translucency = kwinConfig()->group(QStringLiteral("Effect-translucency"));
+    translucency.writeEntry("Inactive", DefaultInactive);
+    translucency.writeEntry("MoveResize", DefaultMoveResize);
+    translucency.sync();
+    setTranslucencyEnabled(false);
+
+    setForcedClasses(forcedClasses()); // rules with the default opacity, reconfigures KWin
+    reconfigureEffect(QStringLiteral("translucency"));
+    emit blurStrengthChanged();
+    emit noiseStrengthChanged();
+    emit forcedOpacityChanged();
+    emit translucencyChanged();
+}
