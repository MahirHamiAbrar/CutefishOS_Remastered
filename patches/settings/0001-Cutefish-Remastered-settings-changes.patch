diff --git a/src/netmonitorclient.cpp b/src/netmonitorclient.cpp
new file mode 100644
index 0000000..223ef9c
--- /dev/null
+++ b/src/netmonitorclient.cpp
@@ -0,0 +1,90 @@
+/*
+ * Cutefish Remastered: Settings side of the network monitor.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * any later version.
+ */
+
+#include "netmonitorclient.h"
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QJsonDocument>
+#include <QProcess>
+#include <QRegularExpression>
+
+NetMonitorClient::NetMonitorClient(QObject *parent)
+    : QObject(parent)
+{
+}
+
+QVariant NetMonitorClient::call(const QString &method, const QVariantList &args) const
+{
+    QDBusMessage msg = QDBusMessage::createMethodCall(QStringLiteral("com.cutefish.NetMonitor"),
+                                                      QStringLiteral("/NetMonitor"),
+                                                      QStringLiteral("com.cutefish.NetMonitor"), method);
+    msg.setArguments(args);
+    const QDBusMessage reply = QDBusConnection::sessionBus().call(msg, QDBus::Block, 2000);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty())
+        return {};
+    return reply.arguments().constFirst();
+}
+
+void NetMonitorClient::refresh()
+{
+    const QVariant connected = call(QStringLiteral("DaemonConnected"));
+    m_available = connected.isValid();
+    m_daemonConnected = connected.toBool();
+    m_interception = call(QStringLiteral("InterceptionEnabled")).toBool();
+    m_stats = QJsonDocument::fromJson(call(QStringLiteral("Stats")).toString().toUtf8()).toVariant().toMap();
+    m_connections = QJsonDocument::fromJson(call(QStringLiteral("Connections"), {300}).toString().toUtf8()).toVariant().toList();
+    m_rules = QJsonDocument::fromJson(call(QStringLiteral("Rules")).toString().toUtf8()).toVariant().toList();
+    emit changed();
+}
+
+void NetMonitorClient::refreshInbound()
+{
+    // Kernel log lines from the "cutefish-in: " nftables rule, e.g.
+    // "... cutefish-in: IN=wlp2s0 OUT= MAC=... SRC=1.2.3.4 DST=... PROTO=TCP SPT=1 DPT=22 ..."
+    QProcess journal;
+    journal.start(QStringLiteral("journalctl"),
+                  {QStringLiteral("-k"), QStringLiteral("--grep=cutefish-in:"), QStringLiteral("-n"),
+                   QStringLiteral("200"), QStringLiteral("-o"), QStringLiteral("short-iso"),
+                   QStringLiteral("--no-pager"), QStringLiteral("-r")});
+    journal.waitForFinished(3000);
+
+    static const QRegularExpression field(QStringLiteral("(IN|SRC|DST|PROTO|DPT)=(\\S*)"));
+    m_inbound.clear();
+    const QStringList lines = QString::fromUtf8(journal.readAllStandardOutput()).split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+    for (const QString &line : lines) {
+        if (!line.contains(QLatin1String("cutefish-in:")))
+            continue;
+        QVariantMap entry{{"time", line.section(QLatin1Char(' '), 0, 0)}};
+        for (auto it = field.globalMatch(line); it.hasNext();) {
+            const auto m = it.next();
+            entry.insert(m.captured(1).toLower(), m.captured(2));
+        }
+        m_inbound << entry;
+    }
+    emit inboundChanged();
+}
+
+void NetMonitorClient::deleteRule(const QString &name)
+{
+    call(QStringLiteral("DeleteRule"), {name});
+    refresh();
+}
+
+void NetMonitorClient::setRuleAction(const QString &name, const QString &action)
+{
+    call(QStringLiteral("SetRuleAction"), {name, action});
+    refresh();
+}
+
+void NetMonitorClient::setInterception(bool enabled)
+{
+    call(QStringLiteral("SetInterception"), {enabled});
+    refresh();
+}
diff --git a/src/netmonitorclient.h b/src/netmonitorclient.h
new file mode 100644
index 0000000..5bb9534
--- /dev/null
+++ b/src/netmonitorclient.h
@@ -0,0 +1,62 @@
+/*
+ * Cutefish Remastered: Settings side of the network monitor. Reads what
+ * cutefish-netmonitor publishes on D-Bus and the inbound firewall's log.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * any later version.
+ */
+
+#ifndef NETMONITORCLIENT_H
+#define NETMONITORCLIENT_H
+
+#include <QObject>
+#include <QVariantList>
+#include <QVariantMap>
+
+class NetMonitorClient : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool available READ available NOTIFY changed)
+    Q_PROPERTY(bool daemonConnected READ daemonConnected NOTIFY changed)
+    Q_PROPERTY(bool interception READ interception NOTIFY changed)
+    Q_PROPERTY(QVariantMap stats READ stats NOTIFY changed)
+    Q_PROPERTY(QVariantList connections READ connections NOTIFY changed)
+    Q_PROPERTY(QVariantList rules READ rules NOTIFY changed)
+    Q_PROPERTY(QVariantList inbound READ inbound NOTIFY inboundChanged)
+
+public:
+    explicit NetMonitorClient(QObject *parent = nullptr);
+
+    bool available() const { return m_available; }
+    bool daemonConnected() const { return m_daemonConnected; }
+    bool interception() const { return m_interception; }
+    QVariantMap stats() const { return m_stats; }
+    QVariantList connections() const { return m_connections; }
+    QVariantList rules() const { return m_rules; }
+    QVariantList inbound() const { return m_inbound; }
+
+    Q_INVOKABLE void refresh();
+    Q_INVOKABLE void refreshInbound();
+    Q_INVOKABLE void deleteRule(const QString &name);
+    Q_INVOKABLE void setRuleAction(const QString &name, const QString &action);
+    Q_INVOKABLE void setInterception(bool enabled);
+
+signals:
+    void changed();
+    void inboundChanged();
+
+private:
+    QVariant call(const QString &method, const QVariantList &args = {}) const;
+
+    bool m_available = false;
+    bool m_daemonConnected = false;
+    bool m_interception = true;
+    QVariantMap m_stats;
+    QVariantList m_connections;
+    QVariantList m_rules;
+    QVariantList m_inbound;
+};
+
+#endif // NETMONITORCLIENT_H
