diff --git a/src/qml/NetMonitor/Main.qml b/src/qml/NetMonitor/Main.qml
new file mode 100644
index 0000000..8e80e0e
--- /dev/null
+++ b/src/qml/NetMonitor/Main.qml
@@ -0,0 +1,223 @@
+/*
+ * Cutefish Remastered: Settings > Network Monitor.
+ *
+ * Outgoing connections come from cutefish-netmonitor (OpenSnitch UI), the
+ * blocked incoming ones from the cutefish-in nftables log.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * any later version.
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.12
+import FishUI 1.0 as FishUI
+import Cutefish.Settings 1.0
+import "../"
+
+ItemPage {
+    id: control
+    headerTitle: qsTr("Network Monitor")
+
+    NetMonitorClient {
+        id: monitor
+    }
+
+    Timer {
+        interval: 2000
+        repeat: true
+        running: control.visible
+        triggeredOnStart: true
+        onTriggered: monitor.refresh()
+    }
+
+    Component.onCompleted: monitor.refreshInbound()
+
+    function baseName(path) {
+        return path ? path.substring(path.lastIndexOf("/") + 1) : qsTr("unknown")
+    }
+
+    Scrollable {
+        anchors.fill: parent
+        contentHeight: layout.implicitHeight
+
+        ColumnLayout {
+            id: layout
+            anchors.fill: parent
+            anchors.bottomMargin: FishUI.Units.largeSpacing
+            spacing: FishUI.Units.largeSpacing * 2
+
+            // Status
+            RoundedItem {
+                RowLayout {
+                    ColumnLayout {
+                        spacing: 0
+                        Layout.fillWidth: true
+
+                        Label {
+                            text: qsTr("Ask before apps connect")
+                        }
+
+                        Label {
+                            Layout.fillWidth: true
+                            wrapMode: Text.WordWrap
+                            color: FishUI.Theme.disabledTextColor
+                            text: !monitor.available ? qsTr("The network monitor is not running.")
+                                  : !monitor.daemonConnected ? qsTr("Waiting for the OpenSnitch service…")
+                                  : qsTr("%1 connections, %2 allowed, %3 blocked, %4 rules")
+                                        .arg(monitor.stats.connections || 0)
+                                        .arg(monitor.stats.accepted || 0)
+                                        .arg(monitor.stats.dropped || 0)
+                                        .arg(monitor.stats.rules || 0)
+                        }
+                    }
+
+                    Switch {
+                        enabled: monitor.daemonConnected
+                        checked: monitor.interception
+                        Layout.fillHeight: true
+                        rightPadding: 0
+                        onClicked: monitor.setInterception(checked)
+                    }
+                }
+            }
+
+            // Outgoing
+            RoundedItem {
+                Label {
+                    text: qsTr("Recent outgoing connections")
+                    color: FishUI.Theme.disabledTextColor
+                }
+
+                Label {
+                    visible: monitor.connections.length === 0
+                    text: qsTr("No connections recorded yet.")
+                }
+
+                Repeater {
+                    model: monitor.connections.slice(0, 100)
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: FishUI.Units.largeSpacing
+
+                        Rectangle {
+                            width: 8
+                            height: 8
+                            radius: 4
+                            color: modelData.action === "allow" ? "#2EB85C" : FishUI.Theme.redColor
+                        }
+
+                        Label {
+                            text: control.baseName(modelData.process)
+                            elide: Text.ElideRight
+                            Layout.preferredWidth: 140
+                        }
+
+                        Label {
+                            text: (modelData.host !== "" ? modelData.host : modelData.ip) + ":" + modelData.port
+                            elide: Text.ElideMiddle
+                            Layout.fillWidth: true
+                        }
+
+                        Label {
+                            text: modelData.protocol
+                            color: FishUI.Theme.disabledTextColor
+                        }
+                    }
+                }
+            }
+
+            // Rules
+            RoundedItem {
+                Label {
+                    text: qsTr("Rules")
+                    color: FishUI.Theme.disabledTextColor
+                }
+
+                Label {
+                    visible: monitor.rules.length === 0
+                    text: qsTr("No rules yet. Answering a prompt with \"Forever\" adds one.")
+                }
+
+                Repeater {
+                    model: monitor.rules
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: FishUI.Units.largeSpacing
+
+                        Label {
+                            text: modelData.description !== "" ? modelData.description : modelData.data
+                            elide: Text.ElideMiddle
+                            Layout.fillWidth: true
+                        }
+
+                        ComboBox {
+                            model: [qsTr("Allow"), qsTr("Deny")]
+                            currentIndex: modelData.action === "allow" ? 0 : 1
+                            onActivated: function(index) {
+                                monitor.setRuleAction(modelData.name, index === 0 ? "allow" : "deny")
+                            }
+                        }
+
+                        Button {
+                            text: qsTr("Delete")
+                            onClicked: monitor.deleteRule(modelData.name)
+                        }
+                    }
+                }
+            }
+
+            // Incoming
+            RoundedItem {
+                RowLayout {
+                    Label {
+                        text: qsTr("Blocked incoming connections")
+                        color: FishUI.Theme.disabledTextColor
+                        Layout.fillWidth: true
+                    }
+
+                    Button {
+                        text: qsTr("Refresh")
+                        onClicked: monitor.refreshInbound()
+                    }
+                }
+
+                Label {
+                    visible: monitor.inbound.length === 0
+                    Layout.fillWidth: true
+                    wrapMode: Text.WordWrap
+                    text: qsTr("Nothing blocked. Incoming connections are refused unless they answer a connection made from this computer.")
+                }
+
+                Repeater {
+                    model: monitor.inbound.slice(0, 100)
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: FishUI.Units.largeSpacing
+
+                        Label {
+                            text: modelData.src || ""
+                            Layout.preferredWidth: 180
+                            elide: Text.ElideRight
+                        }
+
+                        Label {
+                            text: (modelData.proto || "") + " " + qsTr("port %1").arg(modelData.dpt || "-")
+                            Layout.fillWidth: true
+                        }
+
+                        Label {
+                            text: modelData["in"] || ""
+                            color: FishUI.Theme.disabledTextColor
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
