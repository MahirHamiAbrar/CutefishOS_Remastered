+++ b/src/windoweffects.h
@@ -0,0 +1,54 @@
+/*
+ * Cutefish Remastered: blur and per-display Spaces settings, stored in KWin's
+ * own configuration (kwinrc, kwinrulesrc) so KWin stays the single owner.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * any later version.
+ */
+
+#ifndef WINDOWEFFECTS_H
+#define WINDOWEFFECTS_H
+
+#include <QObject>
+#include <QStringList>
+#include <QVariantList>
+
+class WindowEffects : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(int blurStrength READ blurStrength WRITE setBlurStrength NOTIFY blurStrengthChanged)
+    Q_PROPERTY(QVariantList forcedApps READ forcedApps NOTIFY forcedAppsChanged)
+    Q_PROPERTY(QVariantList availableApps READ availableApps NOTIFY forcedAppsChanged)
+    Q_PROPERTY(bool separateSpaces READ separateSpaces WRITE setSeparateSpaces NOTIFY separateSpacesChanged)
+
+public:
+    explicit WindowEffects(QObject *parent = nullptr);
+
+    int blurStrength() const;
+    void setBlurStrength(int strength);
+
+    //! [{ windowClass, name, icon }] of apps whose whole window is blurred.
+    QVariantList forcedApps() const;
+    //! Installed apps that can still be added.
+    QVariantList availableApps() const;
+
+    Q_INVOKABLE void addForcedApp(const QString &windowClass);
+    Q_INVOKABLE void removeForcedApp(const QString &windowClass);
+
+    bool separateSpaces() const;
+    void setSeparateSpaces(bool enabled);
+
+signals:
+    void blurStrengthChanged();
+    void forcedAppsChanged();
+    void separateSpacesChanged();
+
+private:
+    QStringList forcedClasses() const;
+    void setForcedClasses(const QStringList &classes);
+    static void reconfigureKWin();
+};
+
+#endif // WINDOWEFFECTS_H
