new file mode 100644
index 0000000..1c7fb14
--- /dev/null
+++ b/src/windoweffects.cpp
@@ -0,0 +1,198 @@
+/*
+ * Cutefish Remastered: blur and per-display Spaces settings.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * any later version.
+ */
+
+#include "windoweffects.h"
+#include "applicationregistry.h"
+#include "desktopentry.h"
+
+#include <KConfig>
+#include <KConfigGroup>
+#include <KSharedConfig>
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCall>
+#include <QFileInfo>
+
+#include <algorithm>
+
+// Forced apps get a little translucency, otherwise the blur behind an opaque
+// window could never be seen. Applied as ordinary KWin window rules.
+static constexpr int ActiveOpacity = 90;
+static constexpr int InactiveOpacity = 85;
+static const QString RulePrefix = QStringLiteral("cutefish-blur-");
+
+static KSharedConfigPtr kwinConfig()
+{
+    return KSharedConfig::openConfig(QStringLiteral("kwinrc"), KConfig::NoGlobals);
+}
+
+//! The window class KWin sees for an app: its StartupWMClass, else the
+//! desktop file id (what Wayland clients use as their app_id).
+static QString windowClassOf(const DesktopEntry *entry)
+{
+    if (!entry->startupWMClass().isEmpty())
+        return entry->startupWMClass().toLower();
+    return QFileInfo(entry->id()).completeBaseName().toLower();
+}
+
+static QVariantMap describe(const QString &windowClass)
+{
+    for (DesktopEntry *entry : ApplicationRegistry::instance()->applicationEntries()) {
+        if (windowClassOf(entry) == windowClass)
+            return {{"windowClass", windowClass}, {"name", entry->name()}, {"icon", entry->icon()}};
+    }
+    return {{"windowClass", windowClass}, {"name", windowClass}, {"icon", QStringLiteral("application-x-executable")}};
+}
+
+WindowEffects::WindowEffects(QObject *parent)
+    : QObject(parent)
+{
+    connect(ApplicationRegistry::instance(), &ApplicationRegistry::applicationsChanged,
+            this, &WindowEffects::forcedAppsChanged);
+}
+
+int WindowEffects::blurStrength() const
+{
+    return kwinConfig()->group(QStringLiteral("Effect-blur")).readEntry("BlurStrength", 15);
+}
+
+void WindowEffects::setBlurStrength(int strength)
+{
+    strength = std::clamp(strength, 1, 15);
+    if (strength == blurStrength())
+        return;
+
+    KConfigGroup group = kwinConfig()->group(QStringLiteral("Effect-blur"));
+    group.writeEntry("BlurStrength", strength);
+    group.sync();
+    reconfigureKWin();
+    emit blurStrengthChanged();
+}
+
+QStringList WindowEffects::forcedClasses() const
+{
+    QStringList classes = kwinConfig()->group(QStringLiteral("Effect-blur")).readEntry("ForceBlurClasses", QStringList());
+    classes.removeAll(QString());
+    return classes;
+}
+
+QVariantList WindowEffects::forcedApps() const
+{
+    QVariantList apps;
+    for (const QString &windowClass : forcedClasses())
+        apps << describe(windowClass);
+    return apps;
+}
+
+QVariantList WindowEffects::availableApps() const
+{
+    const QStringList forced = forcedClasses();
+    QVariantList apps;
+    for (DesktopEntry *entry : ApplicationRegistry::instance()->applicationEntries()) {
+        const QString windowClass = windowClassOf(entry);
+        if (!entry->shouldShow() || forced.contains(windowClass))
+            continue;
+        apps << QVariantMap{{"windowClass", windowClass}, {"name", entry->name()}, {"icon", entry->icon()}};
+    }
+    std::sort(apps.begin(), apps.end(), [](const QVariant &a, const QVariant &b) {
+        return a.toMap().value("name").toString().localeAwareCompare(b.toMap().value("name").toString()) < 0;
+    });
+    return apps;
+}
+
+void WindowEffects::addForcedApp(const QString &windowClass)
+{
+    QStringList classes = forcedClasses();
+    const QString c = windowClass.trimmed().toLower();
+    if (c.isEmpty() || classes.contains(c))
+        return;
+    classes << c;
+    setForcedClasses(classes);
+}
+
+void WindowEffects::removeForcedApp(const QString &windowClass)
+{
+    QStringList classes = forcedClasses();
+    if (classes.removeAll(windowClass.toLower()) == 0)
+        return;
+    setForcedClasses(classes);
+}
+
+void WindowEffects::setForcedClasses(const QStringList &classes)
+{
+    KConfigGroup blur = kwinConfig()->group(QStringLiteral("Effect-blur"));
+    blur.writeEntry("ForceBlurClasses", classes);
+    blur.sync();
+
+    // Keep our opacity rules in step with the list, leaving the user's own
+    // window rules untouched.
+    KConfig rulesConfig(QStringLiteral("kwinrulesrc"), KConfig::NoGlobals);
+    KConfigGroup general = rulesConfig.group(QStringLiteral("General"));
+    QStringList rules = general.readEntry("rules", QStringList());
+    for (const QString &rule : rules) {
+        if (rule.startsWith(RulePrefix))
+            rulesConfig.deleteGroup(rule);
+    }
+    rules.erase(std::remove_if(rules.begin(), rules.end(),
+                               [](const QString &rule) { return rule.startsWith(RulePrefix); }),
+                rules.end());
+
+    for (const QString &windowClass : classes) {
+        const QString id = RulePrefix + windowClass;
+        KConfigGroup rule = rulesConfig.group(id);
+        rule.writeEntry("Description", QStringLiteral("Cutefish blur: %1").arg(windowClass));
+        rule.writeEntry("wmclass", windowClass);
+        rule.writeEntry("wmclasscomplete", false);
+        rule.writeEntry("wmclassmatch", 1); // exact
+        rule.writeEntry("opacityactive", ActiveOpacity);
+        rule.writeEntry("opacityactiverule", 2); // force
+        rule.writeEntry("opacityinactive", InactiveOpacity);
+        rule.writeEntry("opacityinactiverule", 2);
+        rules << id;
+    }
+    general.writeEntry("rules", rules);
+    general.writeEntry("count", rules.size());
+    rulesConfig.sync();
+
+    reconfigureKWin();
+    emit forcedAppsChanged();
+}
+
+bool WindowEffects::separateSpaces() const
+{
+    return kwinConfig()->group(QStringLiteral("Windows")).readEntry("PerOutputVirtualDesktops", true);
+}
+
+void WindowEffects::setSeparateSpaces(bool enabled)
+{
+    if (enabled == separateSpaces())
+        return;
+
+    KConfigGroup group = kwinConfig()->group(QStringLiteral("Windows"));
+    group.writeEntry("PerOutputVirtualDesktops", enabled);
+    group.sync();
+    reconfigureKWin();
+    emit separateSpacesChanged();
+}
+
+void WindowEffects::reconfigureKWin()
+{
+    // Reloads options and window rules; the blur effect re-reads its own
+    // group only when asked to directly.
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    bus.asyncCall(QDBusMessage::createMethodCall(
+        QStringLiteral("org.kde.KWin"), QStringLiteral("/KWin"),
+        QStringLiteral("org.kde.KWin"), QStringLiteral("reconfigure")));
+    QDBusMessage blur = QDBusMessage::createMethodCall(
+        QStringLiteral("org.kde.KWin"), QStringLiteral("/Effects"),
+        QStringLiteral("org.kde.kwin.Effects"), QStringLiteral("reconfigureEffect"));
+    blur << QStringLiteral("blur");
+    bus.asyncCall(blur);
+}
