From fb4ef17b79d6eadb9ccf54f47e7ebd58766ffb0a Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sat, 26 Sep 2026 05:09:34 +0000
Subject: [PATCH 2/3] Select the first page when the selected sidebar entry is
 removed (no Wi-Fi card)

---
 debian/changelog    | 6 ++++++
 src/qml/SideBar.qml | 6 ++++++
 src/qml/main.qml    | 3 +++
 3 files changed, 15 insertions(+)

diff --git a/debian/changelog b/debian/changelog
index cf76950..879af4e 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-settings (0.8+remastered4) resolute; urgency=medium
+
+  * Select the first page when the selected sidebar entry is removed (no Wi-Fi card)
+
+ -- Cutefish Remastered <remastered@localhost>  Sat, 26 Sep 2026 05:09:34 +0000
+
 cutefish-settings (0.8+remastered3) resolute; urgency=medium
 
   * Network Monitor page; re-enable Hotspot page with password validation and live state
diff --git a/src/qml/SideBar.qml b/src/qml/SideBar.qml
index 8dab323..f3248c4 100644
--- a/src/qml/SideBar.qml
+++ b/src/qml/SideBar.qml
@@ -406,6 +406,12 @@ Item {
                 break
             }
         }
+
+        // Removing the selected entry (Wi-Fi is the first one, and is removed
+        // on machines without a Wi-Fi card) leaves nothing selected while the
+        // removed page stays open. Select the new first entry instead.
+        if (listView.currentIndex < 0 && listModel.count > 0)
+            listView.currentIndex = 0
     }
 
     Battery {
diff --git a/src/qml/main.qml b/src/qml/main.qml
index 2c3e186..794d1d9 100644
--- a/src/qml/main.qml
+++ b/src/qml/main.qml
@@ -69,6 +69,9 @@ FishUI.Window {
     }
 
     function switchPageFromIndex(index) {
+        if (index < 0 || index >= sideBar.model.count)
+            return
+
         _stackView.pop()
         _stackView.push(Qt.resolvedUrl(sideBar.model.get(index).page))
     }
-- 
