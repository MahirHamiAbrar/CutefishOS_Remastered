From 8b11e42d3c1102648470feeaf84fb8805ce8fc51 Mon Sep 17 00:00:00 2001
From: remastered <remastered@localhost>
Date: Sat, 26 Sep 2026 18:23:31 +0600
Subject: [PATCH 3/5] Bluetooth: say when there is no adapter instead of
 showing the switch on

---
 debian/changelog           | 6 ++++++
 src/qml/Bluetooth/Main.qml | 9 +++++++++
 2 files changed, 15 insertions(+)

diff --git a/debian/changelog b/debian/changelog
index 879af4e..0d753ee 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+cutefish-settings (0.8+remastered5) resolute; urgency=medium
+
+  * Bluetooth: say when there is no adapter instead of showing the switch on
+
+ -- Cutefish Remastered <remastered@localhost>  Sat, 26 Sep 2026 18:23:31 +0600
+
 cutefish-settings (0.8+remastered4) resolute; urgency=medium
 
   * Select the first page when the selected sidebar entry is removed (no Wi-Fi card)
diff --git a/src/qml/Bluetooth/Main.qml b/src/qml/Bluetooth/Main.qml
index 0f23c3c..0f388cb 100644
--- a/src/qml/Bluetooth/Main.qml
+++ b/src/qml/Bluetooth/Main.qml
@@ -98,8 +98,17 @@ ItemPage {
                         Layout.fillWidth: true
                     }
 
+                    Label {
+                        visible: !bluetoothSwitch.visible
+                        text: qsTr("No adapter found")
+                        color: FishUI.Theme.disabledTextColor
+                    }
+
                     Switch {
                         id: bluetoothSwitch
+                        // Only rfkill state backs the switch; without an adapter it
+                        // would read "on" with nothing to turn on.
+                        visible: Bluetooth.Manager.adapters.length > 0
                         Layout.fillHeight: true
                         rightPadding: 0
                         checked: !Bluetooth.Manager.bluetoothBlocked
-- 
