diff --git a/src/keyboardlayouts.cpp b/src/keyboardlayouts.cpp
new file mode 100644
index 0000000..e0d8ce7
--- /dev/null
+++ b/src/keyboardlayouts.cpp
@@ -0,0 +1,225 @@
+/*
+ * Cutefish Remastered: keyboard layouts, written to ~/.config/kxkbrc where
+ * KWin reads them.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * any later version.
+ */
+
+#include "keyboardlayouts.h"
+
+#include <KConfig>
+#include <KConfigGroup>
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QFile>
+#include <QXmlStreamReader>
+
+#include <algorithm>
+
+// Switch shortcuts offered, as xkb options (index 0: none).
+static const QList<QPair<const char *, QString>> s_switchOptions = {
+    { QT_TRANSLATE_NOOP("KeyboardLayouts", "None"), QString() },
+    { QT_TRANSLATE_NOOP("KeyboardLayouts", "Meta+Space"), QStringLiteral("grp:win_space_toggle") },
+    { QT_TRANSLATE_NOOP("KeyboardLayouts", "Alt+Shift"), QStringLiteral("grp:alt_shift_toggle") },
+    { QT_TRANSLATE_NOOP("KeyboardLayouts", "Ctrl+Shift"), QStringLiteral("grp:ctrl_shift_toggle") },
+    { QT_TRANSLATE_NOOP("KeyboardLayouts", "Caps Lock"), QStringLiteral("grp:caps_toggle") },
+};
+
+KeyboardLayouts::KeyboardLayouts(QObject *parent)
+    : QObject(parent)
+{
+    // xkb's own catalogue of layouts and variants.
+    QFile rules(QStringLiteral("/usr/share/X11/xkb/rules/evdev.xml"));
+    if (rules.open(QIODevice::ReadOnly)) {
+        QXmlStreamReader xml(&rules);
+        QString layout, name, description;
+        bool inLayoutList = false; // models come first, options after
+        bool inVariant = false;
+        while (!xml.atEnd()) {
+            xml.readNext();
+            if (!inLayoutList) {
+                inLayoutList = xml.isStartElement() && xml.name() == QLatin1String("layoutList");
+                continue;
+            }
+            if (xml.isStartElement()) {
+                if (xml.name() == QLatin1String("layout")) {
+                    layout.clear();
+                    inVariant = false;
+                } else if (xml.name() == QLatin1String("variant")) {
+                    inVariant = true;
+                } else if (xml.name() == QLatin1String("name")) {
+                    name = xml.readElementText();
+                } else if (xml.name() == QLatin1String("description")) {
+                    description = xml.readElementText();
+                }
+            } else if (xml.isEndElement() && xml.name() == QLatin1String("configItem")) {
+                if (!inVariant && layout.isEmpty()) {
+                    layout = name;
+                    m_layoutNames.insert(layout, description);
+                } else if (inVariant && !layout.isEmpty()) {
+                    m_variants[layout].append({ name, description });
+                }
+            } else if (xml.isEndElement() && xml.name() == QLatin1String("variant")) {
+                inVariant = false;
+            } else if (xml.isEndElement() && xml.name() == QLatin1String("layoutList")) {
+                break;
+            }
+        }
+    }
+
+    QList<QPair<QString, QString>> sorted;
+    for (auto it = m_layoutNames.cbegin(); it != m_layoutNames.cend(); ++it)
+        sorted.append({ it.value(), it.key() });
+    std::sort(sorted.begin(), sorted.end());
+    for (const auto &item : sorted)
+        m_available.append(QVariantMap { { "layout", item.second }, { "name", item.first } });
+
+    load();
+}
+
+void KeyboardLayouts::load()
+{
+    KConfig config(QStringLiteral("kxkbrc"), KConfig::NoGlobals);
+    const KConfigGroup group = config.group(QStringLiteral("Layout"));
+    const QStringList layouts = group.readEntry("LayoutList", QString()).split(',', Qt::SkipEmptyParts);
+    const QStringList variants = group.readEntry("VariantList", QString()).split(',');
+
+    m_entries.clear();
+    if (group.readEntry("Use", false)) {
+        for (int i = 0; i < layouts.size(); ++i)
+            m_entries.append({ layouts.at(i).trimmed(), variants.value(i).trimmed() });
+    }
+    if (m_entries.isEmpty())
+        m_entries.append({ QStringLiteral("us"), QString() });
+
+    m_options.clear();
+    m_switchOption.clear();
+    for (const QString &option : group.readEntry("Options", QString()).split(',', Qt::SkipEmptyParts)) {
+        if (option.startsWith(QLatin1String("grp:")))
+            m_switchOption = option;
+        else
+            m_options.append(option);
+    }
+}
+
+void KeyboardLayouts::save()
+{
+    QStringList layouts, variants;
+    for (const Entry &entry : std::as_const(m_entries)) {
+        layouts.append(entry.layout);
+        variants.append(entry.variant);
+    }
+    QStringList options = m_options;
+    if (!m_switchOption.isEmpty())
+        options.append(m_switchOption);
+
+    KConfig config(QStringLiteral("kxkbrc"), KConfig::NoGlobals);
+    KConfigGroup group = config.group(QStringLiteral("Layout"));
+    group.writeEntry("Use", true);
+    group.writeEntry("LayoutList", layouts.join(','));
+    group.writeEntry("VariantList", variants.join(','));
+    group.writeEntry("ResetOldOptions", true);
+    group.writeEntry("Options", options.join(','));
+    config.sync();
+
+    // KWin reloads its keymap on this signal.
+    QDBusConnection::sessionBus().send(QDBusMessage::createSignal(
+        QStringLiteral("/Layouts"), QStringLiteral("org.kde.keyboard"), QStringLiteral("reloadConfig")));
+}
+
+QString KeyboardLayouts::describe(const Entry &entry) const
+{
+    if (!entry.variant.isEmpty()) {
+        for (const auto &variant : m_variants.value(entry.layout)) {
+            if (variant.first == entry.variant)
+                return variant.second;
+        }
+    }
+    return m_layoutNames.value(entry.layout, entry.layout);
+}
+
+QVariantList KeyboardLayouts::layouts() const
+{
+    QVariantList result;
+    for (const Entry &entry : m_entries) {
+        result.append(QVariantMap { { "layout", entry.layout },
+                                    { "variant", entry.variant },
+                                    { "name", describe(entry) } });
+    }
+    return result;
+}
+
+QVariantList KeyboardLayouts::variants(const QString &layout) const
+{
+    QVariantList result { QVariantMap { { "variant", QString() }, { "name", tr("Default") } } };
+    for (const auto &variant : m_variants.value(layout))
+        result.append(QVariantMap { { "variant", variant.first }, { "name", variant.second } });
+    return result;
+}
+
+void KeyboardLayouts::addLayout(const QString &layout, const QString &variant)
+{
+    if (!m_layoutNames.contains(layout))
+        return;
+    for (const Entry &entry : std::as_const(m_entries)) {
+        if (entry.layout == layout && entry.variant == variant)
+            return;
+    }
+
+    m_entries.append({ layout, variant });
+    // Two layouts need a way to switch between them.
+    if (m_entries.size() == 2 && m_switchOption.isEmpty()) {
+        m_switchOption = s_switchOptions.at(1).second;
+        emit switchShortcutChanged();
+    }
+    save();
+    emit layoutsChanged();
+}
+
+void KeyboardLayouts::removeLayout(int index)
+{
+    if (index < 0 || index >= m_entries.size() || m_entries.size() == 1)
+        return;
+    m_entries.removeAt(index);
+    save();
+    emit layoutsChanged();
+}
+
+void KeyboardLayouts::moveLayout(int from, int to)
+{
+    if (from < 0 || from >= m_entries.size() || to < 0 || to >= m_entries.size() || from == to)
+        return;
+    m_entries.move(from, to);
+    save();
+    emit layoutsChanged();
+}
+
+QStringList KeyboardLayouts::switchShortcuts() const
+{
+    QStringList names;
+    for (const auto &option : s_switchOptions)
+        names.append(tr(option.first));
+    return names;
+}
+
+int KeyboardLayouts::switchShortcut() const
+{
+    for (int i = 0; i < s_switchOptions.size(); ++i) {
+        if (s_switchOptions.at(i).second == m_switchOption)
+            return i;
+    }
+    return 0;
+}
+
+void KeyboardLayouts::setSwitchShortcut(int index)
+{
+    if (index < 0 || index >= s_switchOptions.size() || index == switchShortcut())
+        return;
+    m_switchOption = s_switchOptions.at(index).second;
+    save();
+    emit switchShortcutChanged();
+}
diff --git a/src/keyboardlayouts.h b/src/keyboardlayouts.h
new file mode 100644
index 0000000..b63990b
--- /dev/null
+++ b/src/keyboardlayouts.h
@@ -0,0 +1,67 @@
+/*
+ * Cutefish Remastered: keyboard layouts, written to ~/.config/kxkbrc where
+ * KWin reads them.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * any later version.
+ */
+
+#ifndef KEYBOARDLAYOUTS_H
+#define KEYBOARDLAYOUTS_H
+
+#include <QObject>
+#include <QStringList>
+#include <QVariantList>
+
+class KeyboardLayouts : public QObject
+{
+    Q_OBJECT
+    //! The layouts in use, in switching order: [{ layout, variant, name }].
+    Q_PROPERTY(QVariantList layouts READ layouts NOTIFY layoutsChanged)
+    //! Every layout xkb knows: [{ layout, name }], sorted by name.
+    Q_PROPERTY(QVariantList availableLayouts READ availableLayouts CONSTANT)
+    Q_PROPERTY(QStringList switchShortcuts READ switchShortcuts CONSTANT)
+    Q_PROPERTY(int switchShortcut READ switchShortcut WRITE setSwitchShortcut NOTIFY switchShortcutChanged)
+
+public:
+    explicit KeyboardLayouts(QObject *parent = nullptr);
+
+    QVariantList layouts() const;
+    QVariantList availableLayouts() const { return m_available; }
+
+    //! Variants of @p layout: [{ variant, name }], the default first.
+    Q_INVOKABLE QVariantList variants(const QString &layout) const;
+
+    Q_INVOKABLE void addLayout(const QString &layout, const QString &variant);
+    Q_INVOKABLE void removeLayout(int index);
+    Q_INVOKABLE void moveLayout(int from, int to);
+
+    QStringList switchShortcuts() const;
+    int switchShortcut() const;
+    void setSwitchShortcut(int index);
+
+signals:
+    void layoutsChanged();
+    void switchShortcutChanged();
+
+private:
+    struct Entry {
+        QString layout;
+        QString variant;
+    };
+
+    void load();
+    void save();
+    QString describe(const Entry &entry) const;
+
+    QVariantList m_available;
+    QHash<QString, QString> m_layoutNames;                   // us -> English (US)
+    QHash<QString, QList<QPair<QString, QString>>> m_variants; // us -> [(intl, English (US, intl.))]
+    QList<Entry> m_entries;
+    QStringList m_options; // xkb options other than the grp: switch
+    QString m_switchOption;
+};
+
+#endif // KEYBOARDLAYOUTS_H
