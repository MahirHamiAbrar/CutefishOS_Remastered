+
+static QString normalizedLocale(QString name)
+{
+    // "bn_BD.UTF-8", "bn_BD.utf8" -> "bn_BD"; only UTF-8 locales are offered.
+    return name.section('.', 0, 0);
+}
+
+void Language::loadFormats()
+{
+    QProcess localeList;
+    localeList.start(QStringLiteral("locale"), { QStringLiteral("-a") });
+    localeList.waitForFinished(3000);
+    for (const QString &line : QString::fromUtf8(localeList.readAllStandardOutput()).split('\n')) {
+        if (line.contains(QLatin1String(".utf8"), Qt::CaseInsensitive))
+            m_generatedLocales.insert(normalizedLocale(line.trimmed()));
+    }
+
+    QMap<QString, QString> byName;
+    QFile supported(QStringLiteral("/usr/share/i18n/SUPPORTED"));
+    if (supported.open(QIODevice::ReadOnly)) {
+        for (const QString &line : QString::fromUtf8(supported.readAll()).split('\n')) {
+            const QStringList parts = line.simplified().split(' ');
+            if (parts.size() != 2 || parts.at(1) != QLatin1String("UTF-8") || parts.at(0).contains('@'))
+                continue;
+            const QString code = normalizedLocale(parts.at(0));
+            const QLocale locale(code);
+            if (locale.language() == QLocale::C)
+                continue;
+            const QString name = QStringLiteral("%1 (%2) — %3")
+                    .arg(QLocale::languageToString(locale.language()),
+                         QLocale::territoryToString(locale.territory()), code);
+            byName.insert(name, code);
+        }
+    }
+
+    m_formatNames = { tr("Same as the language") };
+    m_formatCodes = { QString() };
+    for (auto it = byName.cbegin(); it != byName.cend(); ++it) {
+        if (m_formatCodes.contains(it.value()))
+            continue;
+        m_formatNames.append(it.key());
+        m_formatCodes.append(it.value());
+    }
+
+    const QString current = QSettings(QStringLiteral("cutefishos"), QStringLiteral("language"))
+            .value(QStringLiteral("formats")).toString();
+    m_currentFormats = qMax(0, m_formatCodes.indexOf(current));
+    emit currentFormatsChanged();
+}
+
+QString Language::formatsPreview() const
+{
+    QString code = m_formatCodes.value(m_currentFormats);
+    if (code.isEmpty())
+        code = m_languageCodes.value(m_currentLanguage, QStringLiteral("en_US"));
+    const QLocale locale(code);
+    return QStringLiteral("%1  ·  %2  ·  %3")
+            .arg(locale.toString(QDate::currentDate(), QLocale::LongFormat),
+                 locale.toString(1234567.89, 'f', 2),
+                 locale.toCurrencyString(1234.5));
+}
+
+void Language::setCurrentFormats(int index)
+{
+    if (index < 0 || index >= m_formatCodes.size() || index == m_currentFormats || m_formatsBusy)
+        return;
+
+    const QString code = m_formatCodes.at(index);
+    if (code.isEmpty() || m_generatedLocales.contains(code)) {
+        saveFormats(index);
+        return;
+    }
+
+    // Not generated yet: glibc would silently fall back to "C".
+    m_formatsBusy = true;
+    emit formatsBusyChanged();
+    auto *process = new QProcess(this);
+    connect(process, &QProcess::finished, this, [this, process, index, code](int exitCode, QProcess::ExitStatus status) {
+        process->deleteLater();
+        m_formatsBusy = false;
+        emit formatsBusyChanged();
+        if (status == QProcess::NormalExit && exitCode == 0) {
+            m_generatedLocales.insert(code);
+            saveFormats(index);
+        } else {
+            emit currentFormatsChanged(); // puts the combo box back
+            emit formatsFailed(tr("Could not generate the %1 locale.").arg(code));
+        }
+    });
+    process->start(QStringLiteral("pkexec"), { QStringLiteral("/usr/sbin/locale-gen"), code + QStringLiteral(".UTF-8") });
+}
+
+void Language::saveFormats(int index)
+{
+    QSettings settings(QStringLiteral("cutefishos"), QStringLiteral("language"));
+    const QString code = m_formatCodes.at(index);
+    if (code.isEmpty())
+        settings.remove(QStringLiteral("formats"));
+    else
+        settings.setValue(QStringLiteral("formats"), code);
+    m_currentFormats = index;
+    emit currentFormatsChanged();
 }
 
 int Language::currentLanguage() const
