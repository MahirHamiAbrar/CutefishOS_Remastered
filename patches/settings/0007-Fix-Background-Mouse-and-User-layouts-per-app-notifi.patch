 #include "notifications.h"
+#include "applicationregistry.h"
+#include "desktopentry.h"
+
+#include <QFileInfo>
+
+#include <algorithm>
+
+//! The key the shell matches against the desktop-entry hint.
+static QString appKey(const DesktopEntry *entry)
+{
+    return QFileInfo(entry->id()).completeBaseName().toLower();
+}
 
 Notifications::Notifications(QObject *parent)
     : QObject(parent)
@@ -31,6 +43,45 @@ Notifications::Notifications(QObject *parent)
                                           "/Notification",
                                           "com.cutefish.Notification",
                                           "doNotDisturbChanged", this, SLOT(onDBusDoNotDisturbChanged()));
+    QDBusConnection::sessionBus().connect("com.cutefish.Notification",
+                                          "/Notification",
+                                          "com.cutefish.Notification",
+                                          "blockedAppsChanged", this, SLOT(onDBusBlockedAppsChanged()));
+    m_blocked = m_iface.property("blockedApps").toStringList();
+
+    connect(ApplicationRegistry::instance(), &ApplicationRegistry::applicationsChanged,
+            this, &Notifications::appsChanged);
+}
+
+QVariantList Notifications::apps() const
+{
+    QVariantList apps;
+    for (DesktopEntry *entry : ApplicationRegistry::instance()->applicationEntries()) {
+        if (!entry->shouldShow())
+            continue;
+        const QString id = appKey(entry);
+        apps << QVariantMap{{"id", id}, {"name", entry->name()}, {"icon", entry->icon()},
+                            {"blocked", m_blocked.contains(id)}};
+    }
+    std::sort(apps.begin(), apps.end(), [](const QVariant &a, const QVariant &b) {
+        return a.toMap().value("name").toString().localeAwareCompare(b.toMap().value("name").toString()) < 0;
+    });
+    return apps;
+}
+
+void Notifications::setAppBlocked(const QString &id, const QString &name, bool blocked)
+{
+    // Senders that give no desktop-entry hint are only known by the name
+    // they pass as app_name, usually the app's display name.
+    m_iface.asyncCall("setAppBlocked", id, blocked);
+    if (!name.isEmpty() && name.toLower() != id)
+        m_iface.asyncCall("setAppBlocked", name, blocked);
+}
+
+void Notifications::onDBusBlockedAppsChanged()
+{
+    m_blocked = m_iface.property("blockedApps").toStringList();
+    emit appsChanged();
 }
 
 bool Notifications::doNotDisturb() const
