+    //! Whether a sidebar entry matches the search: its title, id or keywords.
+    function matches(title, name, keywords) {
+        var needle = searchField.text.trim().toLowerCase()
+        if (needle === "")
+            return true
+        var haystack = (title + " " + name + " " + keywords).toLowerCase()
+        var words = needle.split(/\s+/)
+        for (var i = 0; i < words.length; ++i) {
+            if (haystack.indexOf(words[i]) === -1)
+                return false
+        }
+        return true
+    }
+
+    function firstMatch() {
+        for (var i = 0; i < listModel.count; ++i) {
