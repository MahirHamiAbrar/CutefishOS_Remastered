+QString About::gpuInfo()
+{
+    // lspci -mm: slot "class" "vendor" "device" ...
+    QProcess process;
+    process.start(QStringLiteral("lspci"), {QStringLiteral("-mm")});
+    if (!process.waitForFinished(2000))
+        return QString();
+
+    static const QRegularExpression field(QStringLiteral("\"([^\"]*)\""));
+    QStringList gpus;
+    const QStringList lines = QString::fromUtf8(process.readAllStandardOutput()).split('\n');
+    for (const QString &line : lines) {
+        QStringList fields;
+        for (auto it = field.globalMatch(line); it.hasNext();)
+            fields << it.next().captured(1);
+        if (fields.size() < 3)
+            continue;
+        const QString &cls = fields.at(0);
+        if (!cls.contains(QLatin1String("VGA")) && !cls.contains(QLatin1String("3D")) && !cls.contains(QLatin1String("Display")))
+            continue;
+        QString vendor = fields.at(1);
+        vendor.remove(QLatin1String(" Corporation")).remove(QLatin1String(", Inc.")).remove(QLatin1String(" Inc."));
+        gpus << vendor + QLatin1Char(' ') + fields.at(2);
+    }
+    return gpus.join(QStringLiteral(", "));
+}
+
+QString About::deviceModel()
+{
+    auto read = [](const char *name) {
+        QFile file(QStringLiteral("/sys/class/dmi/id/") + QLatin1String(name));
+        return file.open(QIODevice::ReadOnly) ? QString::fromUtf8(file.readAll()).trimmed() : QString();
+    };
+    const QString vendor = read("sys_vendor");
+    const QString product = read("product_name");
+    if (product.isEmpty() || product.startsWith(vendor))
+        return product.isEmpty() ? vendor : product;
+    return vendor + QLatin1Char(' ') + product;
+}
