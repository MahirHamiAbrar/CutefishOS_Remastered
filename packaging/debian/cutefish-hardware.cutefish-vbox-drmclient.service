# VirtualBox with the VMSVGA adapter only tells the guest about extra
# monitors and new sizes through VBoxDRMClient, which pushes the host's layout
# into the vmwgfx driver. Ubuntu starts it from an X11 Xsession.d hook, so a
# Wayland session never gets it: the second display stayed "disconnected".
[Unit]
Description=VirtualBox display layout helper (extra monitors, resize)
ConditionVirtualization=oracle
After=virtualbox-guest-utils.service
# Exits at once on the old VBoxVGA adapter: don't respawn forever.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/VBoxDRMClient
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
